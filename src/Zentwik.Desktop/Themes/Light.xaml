<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="Brush.Window" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FBFBFC" />
    <SolidColorBrush x:Key="Brush.Border" Color="#E3E6EB" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#EFF1F5" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="#17191C" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#666D77" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#2F6FE4" />
    <SolidColorBrush x:Key="Brush.Accent.Soft" Color="#E8F0FE" />

    <SolidColorBrush x:Key="Brush.Good" Color="#1F9D62" />
    <SolidColorBrush x:Key="Brush.Warn" Color="#B8860B" />
    <SolidColorBrush x:Key="Brush.Bad" Color="#CF4436" />

</ResourceDictionary>
