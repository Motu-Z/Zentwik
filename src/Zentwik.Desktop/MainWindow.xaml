<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zentwik.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zentwik"
        Width="1120" Height="760"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <Grid>
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 全局状态与异常提示条 -->
        <Border Grid.Row="0"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}"
                Background="{DynamicResource Brush.Surface}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="NoticeDot"
                         Grid.Column="0"
                         Width="8" Height="8"
                         VerticalAlignment="Center"
                         Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NoticeIsError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Bad}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Grid.Column="1"
                           Text="{Binding NoticeText}"
                           Style="{StaticResource Text.Primary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Style="{StaticResource FlatButton}"
                        Content="{DynamicResource String.CommonDismiss}"
                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                        Command="{Binding DismissNoticeCommand}"
                        Margin="12,0,0,0" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Style="{StaticResource Sidebar}" ItemContainerStyle="{StaticResource NavTab}">

            <!-- 0: 监控 -->
            <TabItem Header="{DynamicResource String.NavMonitor}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.CommonRefresh}"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                Command="{Binding RefreshCommand}" />
                        <TextBlock Text="{DynamicResource String.NavMonitor}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>

                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.MonitorCpu}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.MonitorMemory}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.MonitorProcesses}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource String.MonitorCores}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding CoreText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12,16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       Text="{DynamicResource String.MonitorCpu}"
                                       Style="{StaticResource Text.Secondary}" />
                            <Canvas Grid.Row="1"
                                    x:Name="ChartCanvas"
                                    ClipToBounds="True"
                                    SizeChanged="OnChartSizeChanged">
                                <Polyline x:Name="CpuLine"
                                          Stroke="{DynamicResource Brush.Accent}"
                                          StrokeThickness="2"
                                          StrokeLineJoin="Round" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="14,10">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.MonitorHardware_summary}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding HardwareSummary}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 1: 方案（索引必须保持 1，供无障碍与虚拟化测试定位） -->
            <TabItem Header="{DynamicResource String.NavPlans}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}"
                                    Content="{DynamicResource String.PlansCreate_toggle}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding ToggleCreatePlanCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource FlatButton}"
                                    Content="{DynamicResource String.CommonRefresh}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource String.PlansTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 新建方案折叠面板 -->
                    <Border Grid.Row="1"
                            Visibility="{Binding IsCreatePlanOpen, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,12"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String.PlansKind}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource String.PlansId}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource String.PlansName}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource String.PlansSpec}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />

                            <ComboBox Grid.Row="1" Grid.Column="0"
                                      AutomationProperties.Name="{DynamicResource String.PlansKind}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding PlanKinds}"
                                      SelectedItem="{Binding NewPlanKind, Mode=TwoWay}"
                                      Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     AutomationProperties.Name="{DynamicResource String.PlansId}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewPlanId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     AutomationProperties.Name="{DynamicResource String.PlansName}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewPlanName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     AutomationProperties.Name="{DynamicResource String.PlansSpec}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewPlanSpec, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Row="1" Grid.Column="4"
                                    Style="{StaticResource AccentButton}"
                                    Content="{DynamicResource String.PlansSave}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding CreatePlanCommand}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2"
                             AutomationProperties.Name="{DynamicResource String.PlansTitle}"
                             ItemsSource="{Binding Plans}"
                             SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Secondary}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontSize="15" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
                                            <TextBlock Text="{Binding Outcome}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 选中方案操作栏 -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}"
                                        Content="{DynamicResource String.PlansApply}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding ApplyPlanCommand}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource FlatButton}"
                                        Content="{DynamicResource String.PlansRevert}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding RevertPlanCommand}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource FlatButton}"
                                        Content="{DynamicResource String.PlansDelete}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DeletePlanCommand}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedPlan.Name, FallbackValue='—'}" Style="{StaticResource Text.Primary}" />
                                <TextBlock Text="{Binding SelectedPlan.Outcome, FallbackValue=''}" Style="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 2: 场景 -->
            <TabItem Header="{DynamicResource String.NavScenes}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource FlatButton}"
                                    Content="{DynamicResource String.ScenesDeactivate}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding DeactivateSceneCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource FlatButton}"
                                    Content="{DynamicResource String.ScenesCreate_toggle}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding ToggleCreateSceneCommand}"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource FlatButton}"
                                    Content="{DynamicResource String.CommonRefresh}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding RefreshCommand}" />
                        </StackPanel>
                        <TextBlock Text="{DynamicResource String.ScenesTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>

                    <!-- 新建场景折叠面板 -->
                    <Border Grid.Row="1"
                            Visibility="{Binding IsCreateSceneOpen, Converter={StaticResource BoolToVisibility}}"
                            Style="{StaticResource Card}"
                            Margin="0,0,0,12"
                            Padding="14,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String.ScenesId}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource String.ScenesName}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource String.ScenesPriority}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource String.ScenesPlan_id}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="{DynamicResource String.ScenesTrigger_kind}" Style="{StaticResource Text.Secondary}" />

                            <TextBox Grid.Row="1" Grid.Column="0"
                                     AutomationProperties.Name="{DynamicResource String.ScenesId}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewSceneId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     AutomationProperties.Name="{DynamicResource String.ScenesName}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewSceneName, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="2"
                                     AutomationProperties.Name="{DynamicResource String.ScenesPriority}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewScenePriority, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,8" />
                            <TextBox Grid.Row="1" Grid.Column="3"
                                     AutomationProperties.Name="{DynamicResource String.ScenesPlan_id}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewScenePlanId, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,8" />
                            <ComboBox Grid.Row="1" Grid.Column="4"
                                      AutomationProperties.Name="{DynamicResource String.ScenesTrigger_kind}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding TriggerKinds}"
                                      SelectedItem="{Binding NewSceneTriggerKind, Mode=TwoWay}"
                                      Margin="0,0,0,8" />

                            <TextBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                     AutomationProperties.Name="{DynamicResource String.ScenesTrigger_arg}"
                                     Style="{StaticResource FlatTextBox}"
                                     Text="{Binding NewSceneTriggerArg, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="{DynamicResource String.ScenesTrigger_arg}"
                                     Margin="0,0,8,0" />
                            <CheckBox Grid.Row="2" Grid.Column="3"
                                      AutomationProperties.Name="{DynamicResource String.ScenesRestore_on_exit}"
                                      Style="{StaticResource FlatCheckBox}"
                                      Content="{DynamicResource String.ScenesRestore_on_exit}"
                                      IsChecked="{Binding NewSceneRestoreOnExit, Mode=TwoWay}"
                                      Margin="0,0,8,0" />
                            <Button Grid.Row="2" Grid.Column="4"
                                    Style="{StaticResource AccentButton}"
                                    Content="{DynamicResource String.ScenesSave}"
                                    AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                    Command="{Binding CreateSceneCommand}" />
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="2"
                             AutomationProperties.Name="{DynamicResource String.ScenesTitle}"
                             ItemsSource="{Binding Scenes}"
                             SelectedItem="{Binding SelectedScene, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Priority}" Style="{StaticResource Text.Secondary}" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontSize="15" Margin="0,3,0,0" />
                                            <TextBlock Text="{Binding Targets}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding LastOutcome}"
                                                   Style="{StaticResource Text.Secondary}"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 选中场景操作栏 -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}"
                                        Content="{DynamicResource String.ScenesActivate}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding ActivateSceneCommand}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource FlatButton}"
                                        Content="{DynamicResource String.ScenesToggle}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding ToggleSceneEnabledCommand}"
                                        Margin="0,0,8,0" />
                                <Button Style="{StaticResource FlatButton}"
                                        Content="{DynamicResource String.ScenesDelete}"
                                        AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                        Command="{Binding DeleteSceneCommand}" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedScene.Name, FallbackValue='—'}" Style="{StaticResource Text.Primary}" />
                                <TextBlock Text="{Binding SelectedScene.LastOutcome, FallbackValue=''}" Style="{StaticResource Text.Secondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- 3: 调校与状态账本 -->
            <TabItem Header="{DynamicResource String.NavTuning}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.CommonRefresh}"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                Command="{Binding RefreshTuningCommand}" />
                        <TextBlock Text="{DynamicResource String.TuningTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.TuningChannel}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding TuningSummary}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding IntelTuningSummary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="{DynamicResource String.TuningCores_title}" Style="{StaticResource Text.Primary}" Margin="0,0,0,8" />
                        <ListBox AutomationProperties.Name="{DynamicResource String.TuningCores_title}"
                                 ItemsSource="{Binding CoreOffsets}"
                                 MaxHeight="136"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,8,0" MinWidth="88">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" />
                                            <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{DynamicResource String.TuningLedger_title}" Style="{StaticResource Text.Primary}" Margin="0,0,0,8" />
                        <ListBox Grid.Row="1"
                                 AutomationProperties.Name="{DynamicResource String.TuningLedger_title}"
                                 ItemsSource="{Binding LedgerEntries}"
                                 SelectedItem="{Binding SelectedLedger, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ItemContainerStyle="{StaticResource RowItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Primary}" />
                                                <TextBlock Text="{Binding ValuesSummary}" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding Owner}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <DockPanel Grid.Row="4" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.TuningRelease}"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                Command="{Binding ReleaseTakeoverCommand}" />
                        <TextBlock Text="{Binding SelectedLedger.Failure, FallbackValue=''}"
                                   Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- 4: 设置 -->
            <TabItem Header="{DynamicResource String.NavSettings}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.CommonRefresh}"
                                AutomationProperties.Name="{Binding Content, RelativeSource={RelativeSource Self}}"
                                Command="{Binding RefreshCommand}" />
                        <TextBlock Text="{DynamicResource String.NavSettings}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsLanguage}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{DynamicResource String.SettingsLanguage}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsTheme}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{DynamicResource String.SettingsTheme}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsAccent}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{DynamicResource String.SettingsAccent}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding Accents}"
                                      SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsScale}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      AutomationProperties.Name="{DynamicResource String.SettingsScale}"
                                      Style="{StaticResource FlatCombo}"
                                      ItemsSource="{Binding ScaleOptions}"
                                      SelectedItem="{Binding UiScale, Mode=TwoWay}" />
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="5" Text="{DynamicResource String.CapsTitle}" Style="{StaticResource Text.Primary}" Margin="0,0,0,10" />

                    <ListBox Grid.Row="6"
                             AutomationProperties.Name="{DynamicResource String.CapsTitle}"
                             ItemsSource="{Binding Capabilities}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Primary}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{Binding State}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
