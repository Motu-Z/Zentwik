<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Zentwik.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zentwik"
        Width="1080" Height="720"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Ideal">

    <TabControl Style="{StaticResource Sidebar}" ItemContainerStyle="{StaticResource NavTab}">

        <!-- 监控 -->
        <TabItem Header="{DynamicResource String.NavMonitor}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="{DynamicResource String.NavMonitor}" Style="{StaticResource Text.Title}" Margin="0,0,0,18" />

                <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,16">
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.MonitorCpu}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding CpuText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.MonitorMemory}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding MemoryText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.MonitorProcesses}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding ProcessText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.MonitorCores}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding CoreText}" Style="{StaticResource Text.Metric}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16,12,16,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="{DynamicResource String.MonitorCpu}"
                                   Style="{StaticResource Text.Secondary}" />
                        <Canvas Grid.Row="1"
                                x:Name="ChartCanvas"
                                ClipToBounds="True"
                                SizeChanged="OnChartSizeChanged">
                            <Polyline x:Name="CpuLine"
                                      Stroke="{DynamicResource Brush.Accent}"
                                      StrokeThickness="2"
                                      StrokeLineJoin="Round" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <!-- 方案 -->
        <TabItem Header="{DynamicResource String.NavPlans}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource String.PlansTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,18" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Plans}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Secondary}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontSize="15" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <!-- 场景 -->
        <TabItem Header="{DynamicResource String.NavScenes}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource String.ScenesTitle}" Style="{StaticResource Text.Title}" Margin="0,0,0,18" />
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Scenes}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,12">
                                <StackPanel>
                                    <TextBlock Text="{Binding Priority}" Style="{StaticResource Text.Secondary}" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontSize="15" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Targets}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>

        <!-- 设置 -->
        <TabItem Header="{DynamicResource String.NavSettings}">
            <StackPanel>
                <TextBlock Text="{DynamicResource String.NavSettings}" Style="{StaticResource Text.Title}" Margin="0,0,0,18" />

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsLanguage}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsTheme}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsAccent}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Accents}"
                                  SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <TextBlock Text="{DynamicResource String.CapsTitle}" Style="{StaticResource Text.Primary}" Margin="0,22,0,10" />

                <ListBox ItemsSource="{Binding Capabilities}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10">
                                <StackPanel>
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Primary}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding State}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
