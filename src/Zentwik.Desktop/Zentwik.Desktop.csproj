<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Zentwik.Desktop</AssemblyName>
    <RootNamespace>Zentwik.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zentwik.Contracts\Zentwik.Contracts.csproj" />
    <ProjectReference Include="..\Zentwik.Localization\Zentwik.Localization.csproj" />
  </ItemGroup>

</Project>
