<UserControl x:Class="Zentwik.Desktop.Views.PlansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl Style="{StaticResource SubNavControl}" ItemContainerStyle="{StaticResource SubNavTab}">
        <TabItem Header="{DynamicResource String.PlansTitle}">
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource FlatButton}"
                        Content="{DynamicResource String.PlansCreate_toggle}"
                        AutomationProperties.Name="{DynamicResource String.PlansCreate_toggle}"
                        Command="{Binding ToggleCreatePlanCommand}"
                        Margin="0,0,8,0" />
                <Button Style="{StaticResource FlatButton}"
                        Content="{DynamicResource String.CommonRefresh}"
                        AutomationProperties.Name="{DynamicResource String.CommonRefresh}"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>
            <TextBlock Text="{DynamicResource String.PlansTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1"
                Visibility="{Binding IsCreatePlanOpen, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource Card}"
                Margin="0,0,0,12"
                Padding="{DynamicResource DensityCardPadding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource String.PlansKind}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{DynamicResource String.PlansId}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{DynamicResource String.PlansName}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{DynamicResource String.PlansSpec}" Style="{StaticResource Text.Secondary}" Margin="0,0,8,4" />

                <ComboBox Grid.Row="1" Grid.Column="0"
                          AutomationProperties.Name="{DynamicResource String.PlansKind}"
                          Style="{StaticResource FlatCombo}"
                          ItemsSource="{Binding PlanKinds}"
                          SelectedItem="{Binding NewPlanKind, Mode=TwoWay}"
                          Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="1"
                         AutomationProperties.Name="{DynamicResource String.PlansId}"
                         Style="{StaticResource FlatTextBox}"
                         Text="{Binding NewPlanId, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="2"
                         AutomationProperties.Name="{DynamicResource String.PlansName}"
                         Style="{StaticResource FlatTextBox}"
                         Text="{Binding NewPlanName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" />
                <TextBox Grid.Row="1" Grid.Column="3"
                         AutomationProperties.Name="{DynamicResource String.PlansSpec}"
                         Style="{StaticResource FlatTextBox}"
                         Text="{Binding NewPlanSpec, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,8,0" />
                <Button Grid.Row="1" Grid.Column="4"
                        Style="{StaticResource AccentButton}"
                        Content="{DynamicResource String.PlansSave}"
                        AutomationProperties.Name="{DynamicResource String.PlansSave}"
                        Command="{Binding CreatePlanCommand}" />
            </Grid>
        </Border>

        <ListBox Grid.Row="2"
                 AutomationProperties.Name="{DynamicResource String.PlansTitle}"
                 ItemsSource="{Binding Plans}"
                 SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource RowItem}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="{DynamicResource DensityRowMargin}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                <Border Background="{DynamicResource Brush.Hover}"
                                        CornerRadius="4"
                                        Padding="6,1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Kind}" Style="{StaticResource Text.Secondary}" FontSize="11" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Caption}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- 选中行下方直接展开参数与执行结果明细 -->
                        <Border x:Name="InlineDetail"
                                Visibility="Collapsed"
                                Margin="0,8,0,2"
                                Padding="10,8"
                                CornerRadius="8"
                                Background="{DynamicResource Brush.RowAlt}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Outcome}" Style="{StaticResource Text.Secondary}" FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                            <Setter TargetName="InlineDetail" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Margin="0,8,0,0"
                Padding="4,12,4,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource AccentButton}"
                            Content="{DynamicResource String.PlansApply}"
                            AutomationProperties.Name="{DynamicResource String.PlansApply}"
                            Command="{Binding ApplyPlanCommand}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource FlatButton}"
                            Content="{DynamicResource String.PlansRevert}"
                            AutomationProperties.Name="{DynamicResource String.PlansRevert}"
                            Command="{Binding RevertPlanCommand}"
                            Margin="0,0,8,0" />
                    <Button Style="{StaticResource FlatButton}"
                            Content="{DynamicResource String.PlansDelete}"
                            AutomationProperties.Name="{DynamicResource String.PlansDelete}"
                            Command="{Binding DeletePlanCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SelectedPlan.Name, FallbackValue='—'}"
                           Style="{StaticResource Text.Primary}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>
            </Grid>
        </TabItem>

        <TabItem Header="Windows 电源方案">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="180" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBox Width="150"
                                 Margin="0,0,8,0"
                                 Style="{StaticResource FlatTextBox}"
                                 AutomationProperties.Name="新电源方案名称"
                                 ToolTip="基于选中方案派生新方案的名称"
                                 Text="{Binding NewPowerSchemeName, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Style="{StaticResource AccentButton}"
                                Margin="0,0,8,0"
                                Content="派生新方案"
                                AutomationProperties.Name="派生新方案"
                                Command="{Binding CreatePowerSchemeCommand}" />
                        <Button Style="{StaticResource FlatButton}"
                                Margin="0,0,8,0"
                                Content="备份"
                                AutomationProperties.Name="备份电源方案"
                                Command="{Binding BackupPowerSchemeCommand}" />
                        <Button Style="{StaticResource FlatButton}"
                                Margin="0,0,8,0"
                                Content="删除"
                                AutomationProperties.Name="删除电源方案"
                                Command="{Binding DeletePowerSchemeCommand}" />
                        <Button Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.CommonRefresh}"
                                AutomationProperties.Name="刷新电源方案"
                                Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <TextBlock Text="Windows 电源方案" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="1"
                         AutomationProperties.Name="Windows 电源方案列表"
                         ItemsSource="{Binding PowerSchemes}"
                         SelectedItem="{Binding SelectedPowerScheme, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource DensityRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding GuidText}" Style="{StaticResource Text.Secondary}" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Badges}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="3" Margin="0,12,0,6">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource FlatButton}"
                            Content="从备份恢复"
                            AutomationProperties.Name="从备份恢复"
                            Command="{Binding RestorePowerBackupCommand}" />
                    <TextBlock Text="电源方案备份库" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <ListBox Grid.Row="4"
                         AutomationProperties.Name="电源方案备份列表"
                         ItemsSource="{Binding PowerBackups}"
                         SelectedItem="{Binding SelectedPowerBackup, Mode=TwoWay}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource DensityRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
