<UserControl x:Class="Zentwik.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Content="{DynamicResource String.CommonRefresh}"
                    AutomationProperties.Name="{DynamicResource String.CommonRefresh}"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Text="{DynamicResource String.NavSettings}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="1" Style="{StaticResource SubNavControl}" ItemContainerStyle="{StaticResource SubNavTab}">
            <TabItem Header="{DynamicResource String.SettingsTheme}">
                <StackPanel>
                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsLanguage}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsLanguage}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsTheme}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsTheme}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsAccent}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsAccent}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Accents}"
                                  SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="12,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsScale}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsScale}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding ScaleOptions}"
                                  SelectedItem="{Binding UiScale, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource String.CapsTitle}">
                <ListBox AutomationProperties.Name="{DynamicResource String.CapsTitle}"
                         ItemsSource="{Binding Capabilities}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="14,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
