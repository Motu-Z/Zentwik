<UserControl x:Class="Zentwik.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Content="{DynamicResource String.CommonRefresh}"
                    AutomationProperties.Name="{DynamicResource String.CommonRefresh}"
                    Command="{Binding RefreshCommand}" />
            <TextBlock Text="{DynamicResource String.NavSettings}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
        </DockPanel>

        <TabControl Grid.Row="1" Style="{StaticResource SubNavControl}" ItemContainerStyle="{StaticResource SubNavTab}">
            <TabItem Header="{DynamicResource String.SettingsTheme}">
                <StackPanel>
                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsLanguage}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsLanguage}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Languages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsTheme}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsTheme}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Themes}"
                                  SelectedItem="{Binding SelectedTheme, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsAccent}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsAccent}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding Accents}"
                                  SelectedItem="{Binding SelectedAccent, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsDensity}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox x:Name="DensityCombo"
                                  Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsDensity}"
                                  Style="{StaticResource FlatCombo}"
                                  SelectionChanged="OnDensitySelectionChanged" />
                    </Grid>

                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsScale}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsScale}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding ScaleOptions}"
                                  SelectedItem="{Binding UiScale, Mode=TwoWay}" />
                    </Grid>

                    <Grid Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsShow_unavailable}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowUnavailableToggle"
                                  Grid.Column="1"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.Name="{DynamicResource String.SettingsShow_unavailable}"
                                  Style="{StaticResource FlatCheckBox}"
                                  Checked="OnShowUnavailableChanged"
                                  Unchecked="OnShowUnavailableChanged" />
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="{DynamicResource String.SettingsRuntime_tab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsMonitor_interval}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsMonitor_interval}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding MonitorIntervalOptions}"
                                  SelectedItem="{Binding SelectedMonitorIntervalMs, Mode=TwoWay}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsSensor_interval}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  AutomationProperties.Name="{DynamicResource String.SettingsSensor_interval}"
                                  Style="{StaticResource FlatCombo}"
                                  ItemsSource="{Binding SensorIntervalOptions}"
                                  SelectedItem="{Binding SelectedSensorIntervalMs, Mode=TwoWay}" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="{DynamicResource DensityRowMargin}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{DynamicResource String.SettingsTelemetry_effective}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding EffectiveTelemetrySummary}" Style="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{DynamicResource String.SettingsModules_title}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" Margin="0,10,0,6" />

                    <Grid Grid.Row="4">
                    <ListBox
                             AutomationProperties.Name="{DynamicResource String.SettingsModules_title}"
                             ItemsSource="{Binding Modules}"
                             SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{DynamicResource DensityRowMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding OptionalBadge}" Style="{StaticResource Text.Secondary}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource String.SettingsModules_empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Modules.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>

                    <DockPanel Grid.Row="5" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{Binding SelectedModule.ActionLabel, FallbackValue='切换可选组件'}"
                                AutomationProperties.Name="{DynamicResource String.SettingsModules_toggle}"
                                Command="{Binding ToggleSelectedModuleCommand}" />
                        <TextBlock Text="{DynamicResource String.SettingsModules_hint}"
                                   Style="{StaticResource Text.Secondary}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource String.CapsTitle}">
                <Grid>
                <ListBox x:Name="CapabilitiesList"
                         AutomationProperties.Name="{DynamicResource String.CapsTitle}"
                         ItemsSource="{Binding Capabilities}"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="{DynamicResource DensityRowMargin}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding State}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource String.SettingsCaps_empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Capabilities.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource String.SettingsLogs_tab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource FlatButton}"
                                Content="{DynamicResource String.CommonRefresh}"
                                AutomationProperties.Name="{DynamicResource String.CommonRefresh}"
                                Command="{Binding RefreshLogsCommand}" />
                        <TextBlock Text="{DynamicResource String.SettingsLogs_caption}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
                    </DockPanel>

                    <Grid Grid.Row="1">
                    <ListBox
                             AutomationProperties.Name="{DynamicResource String.SettingsLogs_tab}"
                             ItemsSource="{Binding Logs}"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource RowItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="{DynamicResource DensityRowMargin}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Text.Secondary}" FontSize="11.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding Level}" Style="{StaticResource Text.Secondary}" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{DynamicResource String.SettingsLogs_empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Logs.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="{DynamicResource String.SettingsDeploy_tab}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="{DynamicResource DensityCardPadding}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource String.SettingsDeploy_mode}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding DeploymentModeText}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="{DynamicResource String.SettingsDeploy_version}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding AgentVersionText}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{DynamicResource String.SettingsDeploy_counts}" Style="{StaticResource Text.Secondary}" />
                                <TextBlock Text="{Binding StateCountsText}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="{DynamicResource DensityCardPadding}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource String.SettingsDeploy_data_dir}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding DataDirectoryText}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock Text="{DynamicResource String.SettingsDeploy_state_path}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding StatePathText}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,8" />
                            <TextBlock Text="{DynamicResource String.SettingsDeploy_log_dir}" Style="{StaticResource Text.Secondary}" />
                            <TextBlock Text="{Binding LogDirectoryText}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="{DynamicResource DensityCardPadding}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{DynamicResource String.SettingsDeploy_errors}" Style="{StaticResource Text.Secondary}" Margin="0,0,0,6" />
                            <ListBox Grid.Row="1"
                                     AutomationProperties.Name="{DynamicResource String.SettingsDeploy_errors}"
                                     ItemsSource="{Binding RecentErrors}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ItemContainerStyle="{StaticResource RowItem}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="{DynamicResource DensityRowMargin}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="68" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Text.Secondary}" FontSize="11.5" />
                                            <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Grid.Row="1" Text="{DynamicResource String.SettingsDeploy_errors_empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding RecentErrors.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
