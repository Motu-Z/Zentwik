<UserControl x:Class="Zentwik.Desktop.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Content="{DynamicResource String.CommonRefresh}"
                    AutomationProperties.Name="{DynamicResource String.CommonRefresh}"
                    Command="{Binding RefreshTuningCommand}" />
            <TextBlock Text="{DynamicResource String.TuningTitle}" Style="{StaticResource Text.Title}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- 能力与硬件通道摘要 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="{DynamicResource DensityCardPadding}">
            <StackPanel>
                <TextBlock Text="{DynamicResource String.TuningChannel}" Style="{StaticResource Text.Secondary}" />
                <TextBlock Text="{Binding TuningSummary}" Style="{StaticResource Text.Primary}" TextWrapping="Wrap" Margin="0,4,0,0" />
                <TextBlock Text="{Binding IntelTuningSummary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- EQ 风格分核 CO 偏移与实时物理核频率阵列 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource String.TuningCores_title}" Style="{StaticResource Text.Primary}" Margin="0,0,0,6" />
                <ListBox AutomationProperties.Name="{DynamicResource String.TuningCores_title}"
                         ItemsSource="{Binding CoreOffsets}"
                         MaxHeight="148"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,6" MinWidth="76">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" FontSize="11" HorizontalAlignment="Center" />
                                    <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}" Margin="4,6,4,5" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource String.TuningCores_empty}" FontSize="11.5" Margin="4,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoreOffsets.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CoreClocksStatusText}" Style="{StaticResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource String.TuningClocks_title}" Style="{StaticResource Text.Primary}" />
                </DockPanel>
                <ListBox AutomationProperties.Name="{DynamicResource String.TuningClocks_title}"
                         ItemsSource="{Binding CoreClocks}"
                         MaxHeight="148"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource RowItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="10,8" Margin="0,0,6,6" MinWidth="88">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Secondary}" FontSize="11" HorizontalAlignment="Center" />
                                    <Border Height="3" CornerRadius="1.5" Background="{DynamicResource Brush.Good}" Margin="4,6,4,5" />
                                    <TextBlock Text="{Binding ValueText}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="{DynamicResource String.TuningClocks_empty}" FontSize="11.5" Margin="4,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CoreClocks.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- 硬件功耗墙（可选组件启用后可见） -->
        <Border Grid.Row="3"
                Visibility="{Binding ShowPowerLimits, Converter={StaticResource BoolToVisibility}}"
                Style="{StaticResource Card}"
                Margin="0,0,0,12"
                Padding="{DynamicResource DensityCardPadding}">
            <StackPanel>
                <DockPanel Margin="0,0,0,6">
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource FlatButton}"
                            Padding="10,4"
                            Content="{DynamicResource String.TuningPower_limits_read}"
                            AutomationProperties.Name="{DynamicResource String.TuningPower_limits_read}"
                            Command="{Binding RefreshPowerLimitsCommand}" />
                    <TextBlock Text="{DynamicResource String.TuningPower_limits_title}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding PowerLimitCurrentText}" Style="{StaticResource Text.Primary}" />
                <TextBlock Text="{Binding PowerLimitFusedText}" Style="{StaticResource Text.Secondary}" FontSize="11.5" Margin="0,2,0,0" />
                <TextBlock Text="{Binding PowerLimitStatusDetail}" Style="{StaticResource Text.Secondary}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Margin="0,0,6,0" Style="{StaticResource FlatTextBox}" AutomationProperties.Name="{DynamicResource String.TuningPower_limits_fast}" ToolTip="FAST (W)" Text="{Binding PowerLimitFastInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="1" Margin="0,0,6,0" Style="{StaticResource FlatTextBox}" AutomationProperties.Name="{DynamicResource String.TuningPower_limits_slow}" ToolTip="SLOW (W)" Text="{Binding PowerLimitSlowInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="2" Margin="0,0,6,0" Style="{StaticResource FlatTextBox}" AutomationProperties.Name="{DynamicResource String.TuningPower_limits_tdc}" ToolTip="TDC (A)" Text="{Binding PowerLimitTdcInput, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="3" Margin="0,0,8,0" Style="{StaticResource FlatTextBox}" AutomationProperties.Name="{DynamicResource String.TuningPower_limits_edc}" ToolTip="EDC (A)" Text="{Binding PowerLimitEdcInput, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="4" Style="{StaticResource AccentButton}" Content="{DynamicResource String.TuningPower_limits_apply}" AutomationProperties.Name="{DynamicResource String.TuningPower_limits_apply}" Command="{Binding ApplyPowerLimitsCommand}" />
                </Grid>
                <TextBlock Text="{Binding PowerLimitApplySummary}" Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <!-- 无边框 StateLedger 账本流 -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{DynamicResource String.TuningLedger_title}" Style="{StaticResource Text.Primary}" Margin="0,0,0,8" />
            <ListBox Grid.Row="1"
                     AutomationProperties.Name="{DynamicResource String.TuningLedger_title}"
                     ItemsSource="{Binding LedgerEntries}"
                     SelectedItem="{Binding SelectedLedger, Mode=TwoWay}"
                     Background="Transparent"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource RowItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="{DynamicResource DensityRowMargin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="OwnerDot"
                                             Width="5" Height="5"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0"
                                             Fill="{DynamicResource Brush.Good}" />
                                    <TextBlock Text="{Binding Target}" Style="{StaticResource Text.Primary}" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Text="{Binding ValuesSummary}" Style="{StaticResource Text.Secondary}" Margin="13,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Owner}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUserOwned}" Value="True">
                                <Setter TargetName="OwnerDot" Property="Fill" Value="{DynamicResource Brush.Warn}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" Text="{DynamicResource String.TuningLedger_empty}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Secondary}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LedgerEntries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource FlatButton}"
                    Content="{DynamicResource String.TuningRelease}"
                    AutomationProperties.Name="{DynamicResource String.TuningRelease}"
                    Command="{Binding ReleaseTakeoverCommand}" />
            <TextBlock Text="{Binding SelectedLedger.Failure, FallbackValue=''}"
                       Style="{StaticResource Text.Secondary}"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
