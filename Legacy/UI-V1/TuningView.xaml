<UserControl x:Class="Zentwik.UI.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">
    <!--
      调校页（混合架构重构版）：CO 逐核 / FMax / Windows 电源策略。
      卡片体系 1:1 取自 wpf-p0（ShellCard 14px 圆角半透明卡）；窗口控制已上移到主窗口自绘标题栏，
      页内不再悬浮窗口按钮。所有 x:Name 与事件签名与 Code-Behind 一一对应，不许改名。
      数据通道不变：tuning.json + apply-tuning；电源策略走 query/apply-power-policy（批次十一契约）。
    -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,4">

            <!-- 1. 顶部信息与操作栏 -->
            <Grid Margin="0,0,0,18">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CircularIconButton}"
                            Click="OnRefreshClick"
                            ToolTip="从硬件读取当前 CO / FMax 与电源策略">
                        <Path Width="18" Height="18"
                              Stretch="Uniform"
                              Data="M21 12a9 9 0 1 1-9-9c2.52 0 4.85.83 6.72 2.24L21 8 M21 3v5h-5"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.8"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="CpuNameText"
                                   Style="{StaticResource CpuNameText}"
                                   Text="AMD Ryzen 9 9955HX" />
                        <TextBlock x:Name="CpuSubText"
                                   Style="{StaticResource CpuSubText}"
                                   Margin="0,4,0,0"
                                   Text="16-Core Processor · SMU 状态：检测中…" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ComboBox x:Name="ProfileComboBox"
                              Style="{StaticResource AppProfileComboBox}"
                              SelectedValuePath="Id"
                              SelectionChanged="OnProfileSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right"
                                            Style="{StaticResource IconGhostButton}"
                                            ToolTip="重命名方案"
                                            PreviewMouseDown="OnRenameItemPreviewMouseDown"
                                            Click="OnRenameItemClick">
                                        <Path Width="14" Height="14"
                                              Stretch="Uniform"
                                              Data="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round" />
                                    </Button>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </DockPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="ApplyButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="应用"
                            MinWidth="80"
                            Margin="12,0,0,0"
                            Click="OnApplyClick" />
                </StackPanel>
            </Grid>

            <!-- 2. SMU 硬件调校 -->
            <Border Style="{StaticResource ShellCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource ShellSectionTitle}" Text="SMU 硬件调校" />
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,20" />

                    <TextBlock Style="{StaticResource RowLabelText}"
                               Text="核心电压偏移 (CO)"
                               ToolTip="Curve Optimizer" />
                    <UniformGrid x:Name="CoGrid" Columns="8" Margin="0,12,0,0" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="最高加速频率 (FMax)"
                                   ToolTip="FMax Target"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Style="{StaticResource NumberBoxBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button Style="{StaticResource StepButton}" Content="−" Click="OnFMaxMinusClick" />
                                    <TextBox x:Name="FMaxBox"
                                             Grid.Column="1"
                                             Style="{StaticResource NumberInput}"
                                             Text="0"
                                             TextChanged="OnFMaxTextChanged" />
                                    <Button Grid.Column="2" Style="{StaticResource StepButton}" Content="+" Click="OnFMaxPlusClick" />
                                </Grid>
                            </Border>
                            <TextBlock Text="MHz"
                                       Foreground="{DynamicResource MutedBrush}"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. Windows 电源策略（批次十一契约：值 + Supported + Error 三件套） -->
            <Border Style="{StaticResource ShellCard}">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource ShellSectionTitle}" Text="Windows 电源策略" />
                        <TextBlock x:Name="PolicySchemeText"
                                   Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,20" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="能效偏好（EPP）"
                                   ToolTip="Energy Performance Preference：0 性能优先，100 能效优先"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="EppBox" Style="{StaticResource AppComboBox}" SelectionChanged="OnPolicyChanged" />
                            <TextBlock x:Name="EppUnsupportedText" Style="{StaticResource MutedText}" Text="本机不支持" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="升频模式（Boost）"
                                   ToolTip="Core Performance Boost：处理器自动升频档位（0 关闭 / 1 开启 / 2 激进 / 3 高效开启 / 4 高效激进）"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="BoostBox" Style="{StaticResource AppComboBox}" SelectionChanged="OnPolicyChanged" />
                            <TextBlock x:Name="BoostUnsupportedText" Style="{StaticResource MutedText}" Text="本机不支持" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="最大处理器状态"
                                   ToolTip="Maximum Processor State：限制处理器最高运行频率的百分比（50-100）"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="MaxStateBox" Style="{StaticResource AppComboBox}" SelectionChanged="OnPolicyChanged" />
                            <TextBlock x:Name="MaxStateUnsupportedText" Style="{StaticResource MutedText}" Text="本机不支持" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="空闲禁用（C-State）"
                                   ToolTip="Processor Idle Disable：开启后处理器不再进入空闲节能状态，响应更快、待机功耗更高"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton x:Name="CStateToggle"
                                          Style="{StaticResource AppToggleSwitch}"
                                          Checked="OnPolicyToggleChanged"
                                          Unchecked="OnPolicyToggleChanged" />
                            <TextBlock x:Name="CStateUnsupportedText" Style="{StaticResource MutedText}" Text="本机不支持" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource RowLabelText}"
                                   Text="ASPM"
                                   ToolTip="Active State Power Management：PCIe 链路空闲节能（0 关闭 / 1 中等 / 2 最大节能）"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <ComboBox x:Name="AspmBox" Style="{StaticResource AppComboBox}" SelectionChanged="OnPolicyChanged" />
                            <TextBlock x:Name="AspmUnsupportedText" Style="{StaticResource MutedText}" Text="本机不支持" VerticalAlignment="Center" Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- 方案重命名：Popup 内嵌输入（不弹独立窗口） -->
    <Popup x:Name="RenamePopup"
           AllowsTransparency="True"
           Placement="Bottom"
           StaysOpen="False"
           Focusable="False"
           Closed="OnRenamePopupClosed">
        <Border Background="{DynamicResource PopupBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14"
                Width="240">
            <StackPanel>
                <TextBlock Style="{StaticResource RowLabelText}" Text="重命名方案" Margin="0,0,0,8" />
                <TextBox x:Name="RenameBox"
                         Style="{StaticResource AppInput}"
                         KeyDown="OnRenameBoxKeyDown" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="取消" MinWidth="68" Margin="0,0,8,0" Click="OnRenameCancelClick" />
                    <Button Style="{StaticResource PrimaryButton}" Content="确认" MinWidth="68" Click="OnRenameConfirmClick" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Popup>

    <!-- 悬浮保存条：任一输入变更时出现 -->
    <Border x:Name="SaveBar"
            Style="{StaticResource SaveBarBorder}"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            Margin="0,0,0,32"
            Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="参数已修改"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0" />
            <Button Style="{StaticResource GhostButton}" Content="放弃" MinWidth="72" Margin="0,0,8,0" Click="OnDiscardClick" />
            <Button Style="{StaticResource PrimaryButton}" Content="保存方案" MinWidth="90" Click="OnSaveClick" />
        </StackPanel>
    </Border>

    <!-- Toast 悬浮轻提示（后续批次上移到主窗口全局层） -->
    <StackPanel x:Name="ToastHost"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,16,0,0"
                IsHitTestVisible="False" />
    </Grid>
</UserControl>
