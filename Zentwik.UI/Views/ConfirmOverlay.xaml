<UserControl x:Class="Zentwik.UI.Views.ConfirmOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid x:Name="Root"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"
          KeyDown="OnRootKeyDown">

        <Border Style="{StaticResource OverlayScrimStyle}" />

        <Border Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource WindowBgBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                Effect="{DynamicResource OverlayShadowEffect}">
            <StackPanel>
                <TextBlock Text="{Binding Title}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Consequences}" Margin="0,18,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Ellipse Grid.Column="0"
                                         Width="4" Height="4"
                                         Margin="0,7,10,0"
                                         VerticalAlignment="Top"
                                         Fill="{DynamicResource TextTertiaryBrush}" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding}"
                                           FontSize="13"
                                           LineHeight="20"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Margin="0,0,8,0"
                            Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="取消危险操作"
                            Command="{Binding CancelCommand}">
                        <TextBlock Text="取消" />
                    </Button>

                    <Button x:Name="ConfirmButton"
                            Grid.Column="2"
                            Background="{DynamicResource DangerBrush}"
                            Foreground="#FF09090B"
                            BorderThickness="0"
                            FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButtonStyle}"
                            automation:AutomationProperties.Name="确认危险操作"
                            Command="{Binding ConfirmCommand}">
                        <TextBlock Text="{Binding ConfirmText}"
                                   Foreground="#FF09090B" />
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
