<UserControl x:Class="Zentwik.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.DataContext>
        <vm:AdvancedViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBarStyle}" Padding="32,0,124,0">
            <TextBlock Text="高级" Style="{StaticResource PageTitleStyle}" />
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollStyle}">
            <StackPanel Margin="32,32,32,32" MaxWidth="1160">

                <!-- ==================== 安全防砖 ==================== -->
                <StackPanel>
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="SAFETY / 安全防砖保护" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="启动异常自动拦截" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="启动异常自动拦截"
                                          IsChecked="{Binding SmartAntiBrick, Mode=TwoWay}" />

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="连续异常启动次数" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource DataTagWarnStyle}"
                                    automation:AutomationProperties.Name="连续异常启动次数">
                                <TextBlock Text="{Binding BootCountText}"
                                           Style="{StaticResource DataTagWarnTextStyle}" />
                            </Border>

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="智能休眠感知" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="智能休眠感知"
                                          IsChecked="{Binding SmartHibernateAware, Mode=TwoWay}" />

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="紧急恢复安全参数" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource DangerButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="一键恢复默认安全值"
                                    Command="{Binding RestoreSafeDefaultsCommand}">
                                <TextBlock Text="一键恢复默认安全值" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 诊断与排障 ==================== -->
                <StackPanel Margin="0,48,0,0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="DIAGNOSTICS / 诊断与排障" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="SMU 硬件自检报告" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="运行自检并导出"
                                    Command="{Binding RunSelfTestCommand}">
                                <TextBlock Text="运行自检并导出" />
                            </Button>

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="导出运行日志" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="导出所有日志"
                                    Command="{Binding ExportLogsCommand}">
                                <TextBlock Text="导出所有日志" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 显示 ==================== -->
                <StackPanel Margin="0,48,0,0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="DISPLAY / 显示" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="Toast 显示时长" Style="{StaticResource RowTitleStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Slider Style="{StaticResource ThinSliderStyle}"
                                        Width="180"
                                        Minimum="1"
                                        Maximum="10"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.Name="Toast 显示时长"
                                        Value="{Binding ToastDuration, Mode=TwoWay}" />

                                <TextBlock Text="{Binding ToastDurationText}"
                                           Width="46"
                                           Margin="14,0,0,0"
                                           TextAlignment="Right"
                                           VerticalAlignment="Center"
                                           FontFamily="{DynamicResource AppMonoFontFamily}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== 危险区 ==================== -->
                <StackPanel Margin="0,48,0,0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="DANGER ZONE / 危险操作" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource DangerZoneStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="停用所有功能" Style="{StaticResource DangerZoneTitleStyle}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerButtonStyle}"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.Name="停用全部功能"
                                        Command="{Binding DisableAllCommand}">
                                    <TextBlock Text="停用服务" />
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="清除所有用户数据（恢复出厂设置）" Style="{StaticResource DangerZoneTitleStyle}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerSolidButtonStyle}"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.Name="清除全部数据"
                                        Command="{Binding ClearAllCommand}">
                                    <TextBlock Text="抹除所有数据" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
