<UserControl x:Class="Zentwik.UI.Views.AdvancedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:AdvancedViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBarStyle}" Padding="32,0,124,0">
            <TextBlock Text="高级" Style="{StaticResource PageTitleStyle}" />
        </Border>

        <ScrollViewer Grid.Row="1" Style="{StaticResource PageScrollStyle}">
            <StackPanel Margin="32,32,32,32" MaxWidth="1160">

                <!-- 安全防砖 -->
                <StackPanel Visibility="{Binding TuningSupported, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="SAFETY / 安全防砖保护" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="启动异常自动拦截" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="连续 3 次写入未完成时，本次启动不应用调校"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="启动异常自动拦截"
                                          IsChecked="{Binding SmartAntiBrick, Mode=TwoWay}" />

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="连续异常启动次数" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="正常退出后清零，满 3 次触发拦截"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Style="{StaticResource DataTagWarnStyle}"
                                    automation:AutomationProperties.Name="连续异常启动次数">
                                <TextBlock Text="{Binding BootCountText}"
                                           Style="{StaticResource DataTagWarnTextStyle}" />
                            </Border>

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="智能休眠感知" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="从睡眠恢复后重新下发当前调校"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <ToggleButton Grid.Column="1"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="智能休眠感知"
                                          IsChecked="{Binding SmartHibernateAware, Mode=TwoWay}" />

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="紧急恢复安全参数" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="核心曲线归零、频率上限回基线"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource DangerButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="一键恢复默认安全值"
                                    Command="{Binding RestoreSafeDefaultsCommand}">
                                <TextBlock Text="恢复" />
                            </Button>
                        </Grid>
                    </Border>

                </StackPanel>

                <!-- 诊断与排障 -->
                <StackPanel Margin="0,48,0,0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="DIAGNOSTICS / 诊断与排障" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="SMU 硬件自检报告" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="生成诊断快照并保存到桌面"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="运行自检并导出"
                                    Command="{Binding RunSelfTestCommand}">
                                <TextBlock Text="导出" />
                            </Button>

                            <Border Style="{StaticResource DashRuleStyle}" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="导出运行日志" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="汇总后台日志保存到桌面"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="导出运行日志"
                                    Command="{Binding ExportLogsCommand}">
                                <TextBlock Text="导出" />
                            </Button>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource FlatRowStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                <TextBlock Text="恢复默认电源策略" Style="{StaticResource RowTitleStyle}" />

                                <TextBlock Text="电源参数回出厂折中值"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,4,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource ActionButtonStyle}"
                                    VerticalAlignment="Center"
                                    automation:AutomationProperties.Name="恢复默认电源策略"
                                    Command="{Binding RestorePowerDefaultsCommand}">
                                <TextBlock Text="恢复" />
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- 危险区 -->
                <StackPanel Margin="0,48,0,0">
                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="DANGER ZONE / 危险操作" Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource DangerZoneStyle}" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="停用全部功能" Style="{StaticResource DangerZoneTitleStyle}" />

                                    <TextBlock Text="关闭自动应用、进程监听、休眠感知与启动拦截"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerButtonStyle}"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.Name="停用全部功能"
                                        Command="{Binding DisableAllCommand}">
                                    <TextBlock Text="停用" />
                                </Button>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <TextBlock Text="清除全部用户数据（恢复出厂设置）" Style="{StaticResource DangerZoneTitleStyle}" />

                                    <TextBlock Text="删除方案、规则与设置，并重置注册表入口"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Style="{StaticResource DangerSolidButtonStyle}"
                                        VerticalAlignment="Center"
                                        automation:AutomationProperties.Name="清除全部数据"
                                        Command="{Binding ClearAllCommand}">
                                    <TextBlock Text="清除" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
