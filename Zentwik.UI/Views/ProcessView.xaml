<UserControl x:Class="Zentwik.UI.Views.ProcessView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:core="clr-namespace:Zentwik.Core.Services;assembly=Zentwik.Core"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:lm="clr-namespace:Zentwik.UI"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
             xmlns:views="clr-namespace:Zentwik.UI.Views"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:SortKeyEqualsConverter x:Key="SortKeyEquals" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProcessViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource TopBarStyle}" Padding="32,0,124,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="进程" Style="{StaticResource PageTitleStyle}" />
                        <views:ProfileBar Kind="{x:Static core:PlanKind.Scheduling}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          shell:WindowChrome.IsHitTestVisibleInChrome="True" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <ToggleButton Style="{StaticResource TopBarToggleStyle}"
                                      automation:AutomationProperties.Name="展开规则与掩码"
                                      IsChecked="{Binding IsDrawerOpen, Mode=TwoWay}"
                                      Visibility="{Binding IsDrawerClosed, Converter={StaticResource BoolToVis}}"
>
                            <TextBlock Text="规则与掩码" />
                        </ToggleButton>

                        <Button Style="{StaticResource DangerButtonStyle}"
                                Margin="8,0,0,0"
                                automation:AutomationProperties.Name="解除全部绑核"
                                Command="{Binding ReleaseAllCommand}"
>
                            <TextBlock Text="全部解绑" />
                        </Button>

                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Margin="8,0,0,0"
                                automation:AutomationProperties.Name="应用调度方案"
                                Command="{Binding ApplyPlanCommand}"
                                IsEnabled="{Binding Source={x:Static vm:PlanHub.Scheduling}, Path=HasCurrent}"
>
                            <TextBlock Text="应用方案" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 前置条件：核心停泊会让软亲和失效，绑核看起来成功但线程会跑出目标集合 -->
            <Border Grid.Row="1"
                    Margin="32,0,32,8"
                    Padding="14,10"
                    CornerRadius="6"
                    Background="{DynamicResource WarningSubtleBrush}"
                    Visibility="{Binding IsScheduleBlocked, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="&#xE7BA;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding ScheduleBlockText}"
                               Margin="10,0,16,0"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <Button Grid.Column="2"
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding FixScheduleBlockCommand}"
                            automation:AutomationProperties.Name="关闭核心停泊"
                            Content="修复" />

                    <Button Grid.Column="3"
                            Style="{StaticResource IconButtonStyle}"
                            Margin="6,0,0,0"
                            Command="{Binding DismissScheduleBlockCommand}"
                            automation:AutomationProperties.Name="关闭提示"
                            Content="&#xE711;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="32,24,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 工具栏：搜索 + 计数 + 批量 -->
                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="300"
                              Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M14.5 14.5 L19 19"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False" />

                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Style="{StaticResource UnderlineFieldStyle}"
                                         conv:InputAssist.Watermark="搜索进程或 PID…"
                                         conv:InputAssist.ClearOnEscape="True"
                                         automation:AutomationProperties.Name="搜索进程"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <!-- 多选后的批量条 -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0"
                                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding SelectionText}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />

                            <ComboBox Style="{StaticResource SelectComboBoxStyle}"
                                      Width="150"
                                      automation:AutomationProperties.Name="批量设置核心掩码"
                                      ItemsSource="{Binding MaskOptions}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding BatchMaskKey, Mode=TwoWay}"
 />

                            <ComboBox Style="{StaticResource SelectComboBoxStyle}"
                                      Width="120"
                                      Margin="8,0,0,0"
                                      automation:AutomationProperties.Name="批量设置优先级"
                                      ItemsSource="{Binding PriorityOptions}"
                                      SelectedItem="{Binding BatchPriority, Mode=TwoWay}"
 />
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource ChipToggleStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="显示系统进程"
                                          Content="系统进程"
                                          IsChecked="{Binding ShowSystemProcesses, Mode=TwoWay}" />

                            <TextBlock VerticalAlignment="Center"
                                       Margin="16,0,0,0"
                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Text="{Binding FilteredProcesses.Count, StringFormat=共 {0} 个进程}" />
                        </StackPanel>
                    </Grid>

                    <!-- 表头 -->
                    <Border Grid.Row="1"
                            Height="34"
                            Padding="0,0,6,0"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TablePid}" />
                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableName}"
                                                  MinWidth="{x:Static lm:LayoutMetrics.TableNameMinWidth}" />
                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableCpu}" />
                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableMask}" />
                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TablePriority}" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton Grid.Column="0"
                                          Style="{StaticResource RowCheckBoxStyle}"
                                          VerticalAlignment="Center"
                                          automation:AutomationProperties.Name="全选进程"
                                          IsChecked="{Binding AreAllSelected, Mode=OneWay}"
                                          Command="{Binding SelectAllCommand}"
 />

                            <TextBlock Grid.Column="1" Text="PID" Style="{StaticResource TableHeaderTextStyle}" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="Auto" Height="Auto"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    automation:AutomationProperties.Name="按进程名排序"
                                    Command="{Binding SortCommand}"
                                    CommandParameter="name">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PROCESS" Style="{StaticResource TableHeaderTextStyle}" />
                                    <Path Data="M0 0 L4 5 L8 0 Z" Fill="{DynamicResource TextTertiaryBrush}"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Converter={StaticResource SortKeyEquals}, ConverterParameter=name}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="Auto" Height="Auto"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    Margin="0,0,8,0"
                                    automation:AutomationProperties.Name="按占用排序"
                                    Command="{Binding SortCommand}"
                                    CommandParameter="cpu">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M0 0 L4 5 L8 0 Z" Fill="{DynamicResource TextTertiaryBrush}"
                                          Margin="0,0,6,0" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Converter={StaticResource SortKeyEquals}, ConverterParameter=cpu}" />
                                    <TextBlock Text="CPU" Style="{StaticResource TableHeaderTextStyle}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="Auto" Height="Auto"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    automation:AutomationProperties.Name="按核心掩码排序"
                                    Command="{Binding SortCommand}"
                                    CommandParameter="mask">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BIND TARGET" Style="{StaticResource TableHeaderTextStyle}" />
                                    <Path Data="M0 0 L4 5 L8 0 Z" Fill="{DynamicResource TextTertiaryBrush}"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Converter={StaticResource SortKeyEquals}, ConverterParameter=mask}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="5"
                                    Style="{StaticResource IconButtonStyle}"
                                    Width="Auto" Height="Auto"
                                    HorizontalAlignment="Left"
                                    Padding="0"
                                    automation:AutomationProperties.Name="按优先级排序"
                                    Command="{Binding SortCommand}"
                                    CommandParameter="priority">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="PRIORITY" Style="{StaticResource TableHeaderTextStyle}" />
                                    <Path Data="M0 0 L4 5 L8 0 Z" Fill="{DynamicResource TextTertiaryBrush}"
                                          Margin="6,0,0,0" VerticalAlignment="Center"
                                          Visibility="{Binding DataContext.SortKey, RelativeSource={RelativeSource AncestorType=UserControl},
                                                       Converter={StaticResource SortKeyEquals}, ConverterParameter=priority}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 行 -->
                    <Grid Grid.Row="2">
                        <ListBox Style="{StaticResource PlainListBoxStyle}"
                                 ItemsSource="{Binding FilteredProcesses}"
                                 ScrollViewer.VerticalScrollBarVisibility="Visible"
                                 automation:AutomationProperties.Name="运行中进程列表">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="52"
                                            Padding="0,0,6,0"
                                            BorderBrush="{DynamicResource LineFaintBrush}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30" />
                                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TablePid}" />
                                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableName}"
                                                                  MinWidth="{x:Static lm:LayoutMetrics.TableNameMinWidth}" />
                                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableCpu}" />
                                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TableMask}" />
                                                <ColumnDefinition Width="{x:Static lm:LayoutMetrics.TablePriority}" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleButton Grid.Column="0"
                                                          Style="{StaticResource RowCheckBoxStyle}"
                                                          VerticalAlignment="Center"
                                                          automation:AutomationProperties.Name="选择此进程"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Pid}"
                                                       Style="{StaticResource TableMonoCellStyle}"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding NameTooltip}" />
                                                <TextBlock Text="{Binding Path}"
                                                           Style="{StaticResource TablePathTextStyle}"
                                                           Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Path}" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding CpuText}"
                                                       Style="{StaticResource TableMonoCellStyle}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />

                                            <ComboBox Grid.Column="4"
                                                      Margin="8,0,12,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SelectComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.MaskOptions,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      DisplayMemberPath="Label"
                                                      SelectedValuePath="Key"
                                                      SelectedValue="{Binding MaskKey, Mode=TwoWay}"
                                                      automation:AutomationProperties.Name="核心掩码" />

                                            <ComboBox Grid.Column="5"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Style="{StaticResource SelectComboBoxStyle}"
                                                      ItemsSource="{Binding DataContext.PriorityOptions,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedItem="{Binding Priority, Mode=TwoWay}"
                                                      automation:AutomationProperties.Name="优先级" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Text="没有匹配的进程"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Top"
                                   Margin="0,32,0,0"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding FilteredProcesses.Count, Converter={StaticResource CountToVis}}" />
                    </Grid>
                </Grid>

                <Border x:Name="DrawerHost"
                        Grid.Column="1"
                        Width="{x:Static lm:LayoutMetrics.ProcessDrawerWidth}"
                        Background="{DynamicResource PanelBrush}"
                        ClipToBounds="True">
                    <Grid Width="{x:Static lm:LayoutMetrics.ProcessDrawerWidth}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 分栏线画在抽屉内部：收起时随宽度一起被裁掉，不留一条孤立的竖线 -->
                        <Border Grid.Column="0" Background="{DynamicResource LineBrush}" />

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="64" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- 抽屉头 -->
                            <Grid Grid.Row="0" Margin="20,0,12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="LIBRARY"
                                           Style="{StaticResource MonoLabelStyle}"
                                           VerticalAlignment="Center" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource IconButtonStyle}"
                                        Width="28" Height="28"
                                        automation:AutomationProperties.Name="收起规则与掩码面板"
                                        Command="{Binding ToggleDrawerCommand}"
>
                                    <Path Style="{StaticResource IconGlyphStyle}"
                                          Width="15" Height="15"
                                          Data="M15 5 L8 12 L15 19"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </Grid>

                            <!-- 页签 -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             GroupName="DrawerTab"
                                             Style="{StaticResource DrawerTabStyle}"
                                             Content="已保存规则"
                                             automation:AutomationProperties.Name="查看已保存规则"
                                             IsChecked="{Binding IsRulesTab, Mode=TwoWay}" />

                                <RadioButton Grid.Column="1"
                                             GroupName="DrawerTab"
                                             Style="{StaticResource DrawerTabStyle}"
                                             Content="自定义掩码"
                                             automation:AutomationProperties.Name="查看自定义掩码"
                                             IsChecked="{Binding IsMasksTab, Mode=TwoWay}" />

                                <Border Grid.ColumnSpan="2"
                                        Height="1"
                                        VerticalAlignment="Bottom"
                                        Background="{DynamicResource LineBrush}"
                                        IsHitTestVisible="False" />
                            </Grid>

                            <!-- 页签 1：已保存规则 -->
                            <Grid Grid.Row="2"
                                  Margin="20,16,20,16"
                                  Visibility="{Binding IsRulesTab, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ListBox Grid.Row="0"
                                         Style="{StaticResource PlainListBoxStyle}"
                                         ItemsSource="{Binding SavedRules}"
                                         automation:AutomationProperties.Name="已保存规则列表">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="RuleCard"
                                                    Background="{DynamicResource WindowBgBrush}"
                                                    BorderBrush="{DynamicResource LineBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="RuleName"
                                                                   Text="{Binding ProcessName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Path}" />

                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding MaskLabel}"
                                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="·"
                                                                       Margin="6,0"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <TextBlock Text="{Binding Priority}"
                                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconButtonStyle}"
                                                                automation:AutomationProperties.Name="禁用或启用规则"
                                                                Command="{Binding DataContext.ToggleRuleCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding ToggleLabel}">
                                                            <Path Style="{StaticResource IconGlyphStyle}"
                                                                  Width="14" Height="14"
                                                                  Data="M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M5.5 5.5 L18.5 18.5"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>

                                                        <Button Style="{StaticResource DangerIconButtonStyle}"
                                                                Margin="4,0,0,0"
                                                                automation:AutomationProperties.Name="删除此规则"
                                                                Command="{Binding DataContext.DeleteRuleCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
>
                                                            <Path Style="{StaticResource IconGlyphStyle}"
                                                                  Width="14" Height="14"
                                                                  Data="M4 6 H20 M9 6 V4 H15 V6 M6 6 L7 20 H17 L18 6"
                                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                    <Setter TargetName="RuleCard" Property="Opacity" Value="0.5" />
                                                    <Setter TargetName="RuleName" Property="TextDecorations" Value="Strikethrough" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Button Grid.Row="1"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Margin="0,12,0,0"
                                        automation:AutomationProperties.Name="清空所有规则"
                                        Command="{Binding ClearAllRulesCommand}"
>
                                    <TextBlock Text="清空全部规则" />
                                </Button>
                            </Grid>

                            <!-- 页签 2：自定义掩码（列表 ↔ 编辑器两视图） -->
                            <Grid Grid.Row="2"
                                  Margin="20,16,20,16"
                                  Visibility="{Binding IsMasksTab, Converter={StaticResource BoolToVis}}">
                                <views:MaskManagerOverlay Owner="{Binding}" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
