<UserControl x:Class="Zentwik.UI.Views.ProfileOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />

        <Style x:Key="ProfileRowStyle" TargetType="Border">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,7,6,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>
                <!-- 选中（正在编辑的这一份）压在 hover 之上 -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 生效中：强调色淡底胶囊 -->
        <Style x:Key="ActiveChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 未保存：琥珀色描边胶囊，只贴当前编辑的那一行 -->
        <Style x:Key="UnsavedChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsCurrent}" Value="True" />
                        <Condition Binding="{Binding DataContext.HasUnsavedChanges,
                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid PreviewMouseLeftButtonDown="OnOverlayPreviewMouseDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Label}"
                       FontFamily="{DynamicResource AppMonoFontFamily}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="26"
                    Padding="10,0"
                    FontSize="12"
                    automation:AutomationProperties.Name="新建方案"
                    Command="{Binding BeginCreateCommand}"
                    Visibility="{Binding IsCreating, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="+ 新建" />
            </Button>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,0,0,8"
              Visibility="{Binding IsCreating, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="NewPlanBox"
                     Grid.Column="0"
                     Style="{StaticResource TextFieldStyle}"
                     conv:InputAssist.Watermark="输入方案名称"
                     conv:InputAssist.ErrorText="{Binding InputError}"
                     automation:AutomationProperties.Name="新方案名称"
                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                     Loaded="OnCreateBoxLoaded"
                     KeyDown="OnCreateKeyDown" />

            <Button Grid.Column="1"
                    Style="{StaticResource ActionButtonStyle}"
                    Height="32"
                    Padding="12,0"
                    Margin="8,0,0,0"
                    automation:AutomationProperties.Name="确认新建"
                    Command="{Binding CommitCreateCommand}">
                <TextBlock Text="创建" />
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="2"
                      MaxHeight="300"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ProfileRowStyle}"
                                MouseLeftButtonDown="OnRowMouseLeftButtonDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 3×16 竖条：标识「正在生效的那一份」 -->
                                <Rectangle Grid.Column="0"
                                           Width="3" Height="16"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Margin="0,0,9,0"
                                           VerticalAlignment="Center"
                                           Fill="{DynamicResource AccentBrush}"
                                           Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />

                                <Grid Grid.Column="1" VerticalAlignment="Center">

                                    <StackPanel Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <Border Style="{StaticResource ActiveChipStyle}">
                                                <TextBlock Text="生效中"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>

                                            <Border Style="{StaticResource UnsavedChipStyle}">
                                                <TextBlock Text="未保存"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Summary}"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <TextBox Style="{StaticResource TextFieldStyle}"
                                             Height="30"
                                             HorizontalAlignment="Stretch"
                                             VerticalAlignment="Center"
                                             conv:InputAssist.ErrorText="{Binding DataContext.InputError,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             automation:AutomationProperties.Name="重命名方案"
                                             Loaded="OnRenameTextBoxLoaded"
                                             Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                             KeyDown="OnRenameKeyDown"
                                             Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}" />
                                </Grid>

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource InverseBoolToVis}}">

                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Width="24" Height="24"
                                            automation:AutomationProperties.Name="重命名此方案"
                                            Command="{Binding DataContext.StartRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconGlyphStyle}"
                                              Width="12" Height="12"
                                              Data="M4 20 H8 L18 10 L14 6 L4 16 Z"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>

                                    <Button Style="{StaticResource DangerIconButtonStyle}"
                                            Width="24" Height="24"
                                            Margin="2,0,0,0"
                                            automation:AutomationProperties.Name="删除方案"
                                            Command="{Binding DataContext.ConfirmDeleteCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconGlyphStyle}"
                                              Width="13" Height="13"
                                              Data="M4 6 H20 M9 6 V4 H15 V6 M6 6 L7 20 H17 L18 6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>

                                <!-- 改名态必须给出行内的确定 / 取消，只靠回车没人知道该按什么 -->
                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0"
                                            Visibility="{Binding IsRenaming, Converter={StaticResource BoolToVis}}">

                                    <Button Style="{StaticResource IconButtonStyle}"
                                            Width="24" Height="24"
                                            automation:AutomationProperties.Name="确认改名"
                                            ToolTip="确认改名（回车）"
                                            Command="{Binding DataContext.CommitRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconGlyphStyle}"
                                              Width="12" Height="12"
                                              Data="M4 12 L9 17 L20 6"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>

                                    <Button Style="{StaticResource DangerIconButtonStyle}"
                                            Width="24" Height="24"
                                            Margin="2,0,0,0"
                                            automation:AutomationProperties.Name="取消改名"
                                            ToolTip="取消（Esc）"
                                            Command="{Binding DataContext.CancelRenameCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Path Style="{StaticResource IconGlyphStyle}"
                                              Width="11" Height="11"
                                              Data="M5 5 L19 19 M19 5 L5 19"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 应用常驻底部：换行不再让按钮在行尾忽隐忽现，也不用猜点哪一份生效 -->
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <Button Style="{StaticResource ActionButtonStyle}"
                    Height="32"
                    HorizontalAlignment="Stretch"
                    FontSize="12"
                    automation:AutomationProperties.Name="应用当前方案"
                    Content="{Binding ApplyLabel}"
                    IsEnabled="{Binding CanApplyCurrent}"
                    Command="{Binding ApplyCommand}" />
        </Grid>
    </Grid>
</UserControl>
