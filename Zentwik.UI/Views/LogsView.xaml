<UserControl x:Class="Zentwik.UI.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lm="clr-namespace:Zentwik.UI"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:CountToVisibilityConverter x:Key="CountToVis" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            右栏整宽动作按钮。
            必须自带模板：只设 Background 会落到系统 Aero2 模板，悬停时画浅蓝底，
            在深色面板上是一块突兀的亮蓝。
        -->
        <Style x:Key="PaneActionStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource WindowBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="16,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource LineBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaneActionDangerStyle"
               TargetType="Button"
               BasedOn="{StaticResource PaneActionStyle}">
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="16,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            一条日志：时间 / 级别 / 正文。
            错误与警告把 3px 竖条贴到行最左缘（参考稿的 border-left），
            正文靠行内 padding 让出这 3px，保证文字左缘与页标题对齐。
        -->
        <DataTemplate x:Key="LogEntryTemplate">
            <Border x:Name="Row"
                    BorderBrush="Transparent"
                    BorderThickness="3,0,0,0"
                    Padding="29,10,32,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Time}"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="12"
                               TextAlignment="Right"
                               Margin="0,1,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Top" />

                    <TextBlock x:Name="LevelText"
                               Grid.Column="2"
                               Text="{Binding Level}"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="12"
                               FontWeight="Bold"
                               Margin="0,1,0,0"
                               VerticalAlignment="Top" />

                    <TextBlock x:Name="MsgText"
                               Grid.Column="4"
                               Text="{Binding Message}"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                </Trigger>

                <DataTrigger Binding="{Binding Level}" Value="DEBUG">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource LogDebugBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="INFO">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource LogInfoBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="WARN">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource LogWarnBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource LogWarnBrush}" />
                    <Setter TargetName="MsgText" Property="Foreground" Value="{DynamicResource LogWarnTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="ERROR">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource LogErrorBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource LogErrorBrush}" />
                    <Setter TargetName="MsgText" Property="Foreground" Value="{DynamicResource LogErrorTextBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="FATAL">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource LogFatalBrush}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource LogFatalBrush}" />
                    <Setter TargetName="MsgText" Property="Foreground" Value="{DynamicResource LogErrorTextBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:LogsViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBarStyle}" Padding="32,0,124,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="日志" Style="{StaticResource PageTitleStyle}" />

                <ToggleButton Grid.Column="2"
                              Style="{StaticResource TopBarToggleStyle}"
                              VerticalAlignment="Center"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              automation:AutomationProperties.Name="控制中心"
                              IsChecked="{Binding IsStatsOpen, Mode=TwoWay}"
>
                    <TextBlock Text="控制中心" />
                </ToggleButton>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：日志流 -->
            <Grid Grid.Column="0" Background="{DynamicResource WindowBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 工具条：搜索 + 级别分段 -->
                <Border Grid.Row="0"
                        Background="{DynamicResource PanelBrush}"
                        BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="32,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="300"
                              HorizontalAlignment="Left">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Data="M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 M14.5 14.5 L19 19"
                                  Stroke="{DynamicResource TextSecondaryBrush}"
                                  StrokeThickness="1.6"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  VerticalAlignment="Center"
                                  IsHitTestVisible="False" />

                            <Grid Grid.Column="1" Margin="8,0,0,0">
                                <TextBox Style="{StaticResource UnderlineFieldStyle}"
                                         conv:InputAssist.Watermark="搜索日志内容…"
                                         conv:InputAssist.ClearOnEscape="True"
                                         automation:AutomationProperties.Name="搜索日志"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                            </Grid>
                        </Grid>

                        <Border Grid.Column="1"
                                Style="{StaticResource SegmentGroupStyle}"
                                VerticalAlignment="Center"
                                automation:AutomationProperties.Name="日志级别筛选">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="LogLevel"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             Content="ALL"
                                             automation:AutomationProperties.Name="显示全部级别"
                                             IsChecked="{Binding IsFilterAll, Mode=TwoWay}" />

                                <RadioButton GroupName="LogLevel"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             Content="INFO"
                                             automation:AutomationProperties.Name="只看信息"
                                             IsChecked="{Binding IsFilterInfo, Mode=TwoWay}" />

                                <RadioButton GroupName="LogLevel"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             Content="WARN"
                                             automation:AutomationProperties.Name="只看警告"
                                             IsChecked="{Binding IsFilterWarn, Mode=TwoWay}" />

                                <RadioButton GroupName="LogLevel"
                                             Style="{StaticResource SegmentRadioButtonStyle}"
                                             Content="ERR"
                                             automation:AutomationProperties.Name="只看错误"
                                             IsChecked="{Binding IsFilterError, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- 日志列表 -->
                <Grid Grid.Row="1">
                    <ListBox x:Name="LogList"
                             ItemsSource="{Binding FilteredEntries}"
                             ItemTemplate="{StaticResource LogEntryTemplate}"
                             SelectionMode="Extended"
                             Margin="0,8,0,8"
                             automation:AutomationProperties.Name="日志列表"
                             Style="{StaticResource PlainListBoxStyle}" />

                    <TextBlock Text="暂无日志"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0,40,0,0"
                               IsHitTestVisible="False"
                               Visibility="{Binding FilteredEntries.Count, Converter={StaticResource CountToVis}}" />
                </Grid>
            </Grid>

            <Border x:Name="StatsHost"
                    Grid.Column="1"
                    Width="{x:Static lm:LayoutMetrics.LogStatsWidth}"
                    Background="{DynamicResource PanelBrush}"
                    ClipToBounds="True">
                <Grid Width="{x:Static lm:LayoutMetrics.LogStatsWidth}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 分栏线画在栏内：收起时随宽度一起被裁掉，不留孤立的竖线 -->
                    <Border Grid.Column="0" Background="{DynamicResource LineBrush}" />

                    <Grid Grid.Column="1" Margin="24,24,24,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 数据统计 -->
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="数据统计" Style="{StaticResource MonoLabelStyle}" Margin="0,0,0,16" />

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Text="总日志" Style="{StaticResource StatLabelStyle}" />
                                        <TextBlock Text="{Binding TotalCount}" Style="{StaticResource StatValueStyle}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="信息" Style="{StaticResource StatLabelStyle}" />
                                        <TextBlock Text="{Binding InfoCount}"
                                                   Style="{StaticResource StatValueStyle}"
                                                   Foreground="{DynamicResource LogInfoBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="警告" Style="{StaticResource StatLabelStyle}" />
                                        <TextBlock Text="{Binding WarnCount}"
                                                   Style="{StaticResource StatValueStyle}"
                                                   Foreground="{DynamicResource LogWarnBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}">
                                    <StackPanel>
                                        <TextBlock Text="错误" Style="{StaticResource StatLabelStyle}" />
                                        <TextBlock Text="{Binding ErrorCount}"
                                                   Style="{StaticResource StatValueStyle}"
                                                   Foreground="{DynamicResource LogErrorBrush}"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>

                        <!-- 最新异常 -->
                        <StackPanel Grid.Row="1"
                                    Margin="0,28,0,0"
                                    Visibility="{Binding HasIssue, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="最新异常" Style="{StaticResource MonoLabelStyle}" Margin="0,0,0,16" />
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource IssueCardStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LatestIssueLevel}" Value="WARN">
                                                <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarningBorderBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Border Width="4"
                                            HorizontalAlignment="Left"
                                            Margin="-16,-14,0,-16"
                                            IsHitTestVisible="False">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LatestIssueLevel}" Value="WARN">
                                                        <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding LatestIssueTime}"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" />

                                            <Border HorizontalAlignment="Right"
                                                    CornerRadius="4"
                                                    Padding="8,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding LatestIssueLevel}" Value="WARN">
                                                                <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding LatestIssueLevel}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#FF09090B" />
                                            </Border>
                                        </Grid>

                                        <TextBlock Text="{Binding LatestIssueMessage}"
                                                   Margin="0,12,0,0"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   FontSize="13"
                                                   LineHeight="21"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource LogErrorTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LatestIssueLevel}" Value="WARN">
                                                            <Setter Property="Foreground" Value="{DynamicResource LogWarnTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- 日志操作：靠栏底 -->
                        <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                            <Border BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,24,0,0">
                                <StackPanel>
                                    <TextBlock Text="日志操作" Style="{StaticResource MonoLabelStyle}" Margin="0,0,0,16" />

                                    <Button Style="{StaticResource PaneActionStyle}"
                                            automation:AutomationProperties.Name="打开日志目录"
                                            Command="{Binding OpenLogFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  Data="M3 7 V19 A1 1 0 0 0 4 20 H20 A1 1 0 0 0 21 19 V9 A1 1 0 0 0 20 8 H11 L9 5 H4 A1 1 0 0 0 3 6 Z" />
                                            <TextBlock Text="打开日志目录" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Style="{StaticResource PaneActionStyle}"
                                            Margin="0,12,0,0"
                                            automation:AutomationProperties.Name="复制全部诊断信息"
                                            Command="{Binding CopyDiagnosticsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  Data="M9 9 H20 A1 1 0 0 1 21 10 V20 A1 1 0 0 1 20 21 H9 A1 1 0 0 1 8 20 V10 A1 1 0 0 1 9 9 Z M16 9 V4 A1 1 0 0 0 15 3 H4 A1 1 0 0 0 3 4 V15 A1 1 0 0 0 4 16 H8" />
                                            <TextBlock Text="复制全部诊断信息" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>


                                    <Button Style="{StaticResource PaneActionDangerStyle}"
                                            Margin="0,12,0,0"
                                            automation:AutomationProperties.Name="清空日志"
                                            Command="{Binding ClearCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Width="16" Height="16"
                                                  VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.6"
                                                  StrokeLineJoin="Round"
                                                  Data="M4 6 H20 M9 6 V4 H15 V6 M6 6 L7 20 H17 L18 6 M10 10 V16 M14 10 V16" />
                                            <TextBlock Text="清空当前日志" Margin="12,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 文件信息 -->
                            <TextBlock Margin="0,16,0,0"
                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                       FontSize="12"
                                       LineHeight="20"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       ToolTip="{Binding LogFolderPath}">
                                <Run Text="路径  " Foreground="{DynamicResource TextTertiaryBrush}" /><Run Text="{Binding LogFolderDisplay, Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Margin="0,4,0,0"
                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="大小  " Foreground="{DynamicResource TextTertiaryBrush}" /><Run Text="{Binding LogFolderSizeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
