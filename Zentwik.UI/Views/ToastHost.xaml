<UserControl x:Class="Zentwik.UI.Views.ToastHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border x:Name="ToastCard"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,24,24"
            Padding="14,10"
            Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Effect="{DynamicResource OverlayShadowEffect}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
        <StackPanel Orientation="Horizontal">
            <Path Data="M3 8 L6.5 11.5 L13 5"
                  Stroke="{DynamicResource SuccessBrush}"
                  StrokeThickness="1.8"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  Width="12" Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  Margin="0,0,10,0" />

            <TextBlock Text="{Binding Message}"
                       FontSize="13"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
