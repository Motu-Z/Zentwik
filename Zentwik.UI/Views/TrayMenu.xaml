<UserControl x:Class="Zentwik.UI.Views.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <Style x:Key="TrayItemStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource NoFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ItemHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Popup x:Name="Popup"
               Placement="AbsolutePoint"
               AllowsTransparency="True"
               StaysOpen="False"
               PopupAnimation="Fade"
               KeyDown="OnPopupKeyDown">
            <Border x:Name="Panel"
                    Width="176"
                    Margin="10"
                    Padding="4"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Effect="{DynamicResource OverlayShadowEffect}">
                <StackPanel>
                    <Button x:Name="ShowButton" Style="{StaticResource TrayItemStyle}" Click="OnShowClick">
                        <TextBlock Text="显示窗口" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>

                    <Border Height="1" Margin="8,4" Background="{DynamicResource LineFaintBrush}" />

                    <TextBlock Text="禁用配置（预留）"
                               Margin="10,8"
                               FontSize="12"
                               Foreground="{DynamicResource TextTertiaryBrush}" />

                    <Border Height="1" Margin="8,4" Background="{DynamicResource LineFaintBrush}" />

                    <Button Style="{StaticResource TrayItemStyle}" Click="OnExitClick">
                        <TextBlock Text="退出程序" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Button>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
