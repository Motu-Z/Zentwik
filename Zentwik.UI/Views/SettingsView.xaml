<UserControl x:Class="Zentwik.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:lm="clr-namespace:Zentwik.UI"
             xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:SettingsViewModel />
    </UserControl.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource TopBarStyle}" Padding="32,0,124,0">
            <TextBlock Text="通用" Style="{StaticResource PageTitleStyle}" />
        </Border>

        <!-- 常规左右分栏：设置区吃剩余宽度，关于栏固定 380 贴右缘，不做整组居中 -->
        <Grid Grid.Row="1" Background="{DynamicResource WindowBgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="{x:Static lm:LayoutMetrics.AboutPane}" />
                </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource WindowBgBrush}">
                <ScrollViewer Style="{StaticResource PageScrollStyle}">
                    <StackPanel Margin="32,32,32,32">

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="APPEARANCE / 外观" Style="{StaticResource SectionTitleStyle}" />
                        </Border>

                        <!-- 主题模式 -->
                        <Border Style="{StaticResource FlatRowStyle}" Padding="0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="主题模式"
                                           Style="{StaticResource RowTitleStyle}" />

                                <Border Grid.Column="1"
                                        Style="{StaticResource SegmentGroupStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="ThemeMode"
                                                     Style="{StaticResource SegmentRadioButtonStyle}"
                                                     automation:AutomationProperties.Name="浅色主题"
                                                     IsChecked="{Binding IsLightSelected, Mode=TwoWay}">
                                            <TextBlock Text="浅色" />
                                        </RadioButton>

                                        <RadioButton GroupName="ThemeMode"
                                                     Style="{StaticResource SegmentRadioButtonStyle}"
                                                     automation:AutomationProperties.Name="深色主题"
                                                     IsChecked="{Binding IsDarkSelected, Mode=TwoWay}">
                                            <TextBlock Text="深色" />
                                        </RadioButton>

                                        <RadioButton GroupName="ThemeMode"
                                                     Style="{StaticResource SegmentRadioButtonStyle}"
                                                     automation:AutomationProperties.Name="跟随系统主题"
                                                     IsChecked="{Binding IsSystemSelected, Mode=TwoWay}">
                                            <TextBlock Text="跟随系统" />
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 色彩来源 -->
                        <Border Style="{StaticResource FlatRowStyle}" Padding="0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="色彩"
                                           Style="{StaticResource RowTitleStyle}" />

                                <Border Grid.Column="1"
                                        Style="{StaticResource SegmentGroupStyle}"
                                        VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton GroupName="AccentMode"
                                                     Style="{StaticResource SegmentRadioButtonStyle}"
                                                     automation:AutomationProperties.Name="跟随系统色彩"
                                                     IsChecked="{Binding IsSystemAccentSelected, Mode=TwoWay}">
                                            <TextBlock Text="系统" />
                                        </RadioButton>

                                        <RadioButton GroupName="AccentMode"
                                                     Style="{StaticResource SegmentRadioButtonStyle}"
                                                     automation:AutomationProperties.Name="自定义色彩"
                                                     IsChecked="{Binding IsCustomAccentSelected, Mode=TwoWay}">
                                            <TextBlock Text="个性" />
                                        </RadioButton>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- 色相：只在「个性」下展开 -->
                        <Grid x:Name="ColorPanelHost" Height="0" Visibility="Collapsed" ClipToBounds="True">
                            <Grid x:Name="ColorPanelBody" Height="64" Opacity="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="色相" Style="{StaticResource RowTitleStyle}" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="22" Height="22"
                                            CornerRadius="4"
                                            Background="{DynamicResource AccentBrush}" />

                                    <Slider Width="180"
                                            Margin="14,0,0,0"
                                            Style="{StaticResource HueSliderStyle}"
                                            Minimum="0" Maximum="360"
                                            Value="{Binding HueValue, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            automation:AutomationProperties.Name="强调色色相" />

                                    <TextBox Width="108"
                                             Margin="14,0,0,0"
                                             Style="{StaticResource TextFieldStyle}"
                                             FontFamily="{DynamicResource AppFontFamily}"
                                             FontWeight="SemiBold"
                                             TextAlignment="Center"
                                             conv:InputAssist.Watermark="HEX"
                                             conv:InputAssist.SelectAllOnFocus="True"
                                             automation:AutomationProperties.Name="强调色十六进制值"
                                             Text="{Binding HexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             LostFocus="OnHexLostFocus"
                                             KeyDown="OnHexKeyDown" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 分栏线：外层背景改成窗口色后，这条线要自己画 -->
            <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />

            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 背景巨字 -->
                    <TextBlock Grid.RowSpan="4"
                               Text="Z"
                               FontSize="300"
                               FontWeight="Black"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Opacity="0.35"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />

                    <StackPanel Grid.Row="1" Margin="32,0" HorizontalAlignment="Center">

                        <!-- 应用图标：与侧栏同一个 BrandLogoImage，颜色随强调色重绘 -->
                        <Image Source="{DynamicResource BrandLogoImage}"
                               Width="62"
                               Height="82"
                               Stretch="Uniform"
                               HorizontalAlignment="Center" />

                        <TextBlock Text="ZENTWIK"
                                   Margin="0,24,0,8"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding AppVersion}"
                                   Margin="0,0,0,24"
                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                   FontSize="14"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="专为 AMD Ryzen 处理器设计的轻量级硬件调校与核心调度工具。"
                                   MaxWidth="260"
                                   Margin="0,0,0,32"
                                   FontSize="13"
                                   LineHeight="21"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource AboutLinkButtonStyle}"
                                    automation:AutomationProperties.Name="打开项目源码"
                                    Click="OnRepositoryClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16"
                                          Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                                    <TextBlock Text="源码" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2"
                                    Style="{StaticResource AboutLinkButtonStyle}"
                                    automation:AutomationProperties.Name="检查更新"
                                    Click="OnCheckUpdateClick">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="16" Height="16"
                                          Stretch="Uniform"
                                          Style="{StaticResource IconGlyphStyle}"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          Data="M21 2 L21 8 L15 8 M3 12 A9 9 0 1 0 5.63 5.64 L21 11" />
                                    <TextBlock Text="更新" Margin="8,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- 底部落款与版权 -->
                    <StackPanel Grid.Row="3" Margin="24,0,24,24" HorizontalAlignment="Center">
                        <TextBlock Text="// 关上我身后的门，我走了。"
                                   FontFamily="{DynamicResource AppCommentFontFamily}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="// Zentwik"
                                   Margin="0,2,0,0"
                                   FontFamily="{DynamicResource AppCommentFontFamily}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="Licensed under MIT · © 2026 Zentwik Project"
                                   Margin="0,10,0,0"
                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                   FontSize="11"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
