<UserControl x:Class="Zentwik.UI.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:core="clr-namespace:Zentwik.Core.Services;assembly=Zentwik.Core"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:lm="clr-namespace:Zentwik.UI"
             xmlns:views="clr-namespace:Zentwik.UI.Views"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:DimOpacityConverter x:Key="DimOpacity" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource TopBarStyle}"
                Padding="32,0,124,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="调校" Style="{StaticResource PageTitleStyle}" />

                <views:ProfileBar Kind="{x:Static core:PlanKind.Tuning}" Grid.Column="1"
                                  Margin="16,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="回读"
                            Command="{Binding ReadbackCommand}"
                            IsEnabled="{Binding CanOperate}"
>
                        <TextBlock Text="回读" />
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="取消调校改动"
                            Command="{Binding DiscardCommand}"
                            IsEnabled="{Binding CanOperate}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="取消" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="应用参数"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanSave}">
                        <TextBlock Text="应用参数" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource PageScrollStyle}"
                          Opacity="{Binding SmuAvailable, Converter={StaticResource DimOpacity}}">
                <StackPanel MaxWidth="{x:Static lm:LayoutMetrics.FormContentWidth}"
                            Margin="32,32,32,32">

                    <Border Style="{StaticResource SectionHeaderStyle}">
                        <TextBlock Text="CURVE OPTIMIZER / 核心电压偏移"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <!-- 8 列自然排布：16 核两行、8 核一行；不为凑整去改列数 -->
                    <ItemsControl ItemsSource="{Binding CoreMargins}" Margin="0,22,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBrush}"
                                        CornerRadius="4"
                                        Margin="0,0,12,12"
                                        Padding="8,11">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}"
                                                   HorizontalAlignment="Center"
                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />

                                        <TextBox Width="76"
                                                 HorizontalAlignment="Center"
                                                 TextAlignment="Center"
                                                 Margin="0,3,0,0"
                                                 conv:InputAssist.SelectAllOnFocus="True"
                                                 automation:AutomationProperties.Name="{Binding DisplayName, StringFormat=核心 {0} 偏移值}"
                                                 IsReadOnly="{Binding IsReadOnly}"
                                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
>
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource CoreNumberFieldStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,0">
                        <TextBlock Text="FMAX TARGET / 最高加速频率"
                                   Style="{StaticResource SectionTitleStyle}" />
                    </Border>

                    <Border Style="{StaticResource PanelStyle}" Padding="20,14" Margin="0,22,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="频率上限"
                                       Style="{StaticResource RowTitleStyle}"
                                       VerticalAlignment="Center" />

                            <!-- 滑块吃掉剩余宽度：定宽 360 在宽窗里会在右侧留下一大片空白 -->
                            <Slider Grid.Column="1"
                                    Style="{StaticResource ThinSliderStyle}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,24,0"
                                    Minimum="{Binding FMaxMinimum}"
                                    Maximum="{Binding FMaxMaximum}"
                                    Value="{Binding FMaxMHz, Mode=TwoWay}"
                                    automation:AutomationProperties.Name="最高加速频率"
 />

                            <TextBox Grid.Column="2"
                                     Style="{StaticResource CoreNumberFieldStyle}"
                                     Width="88"
                                     FontSize="30"
                                     TextAlignment="Right"
                                     conv:InputAssist.SelectAllOnFocus="True"
                                     automation:AutomationProperties.Name="最高加速频率数值"
                                     Text="{Binding FMaxText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
 />

                            <TextBlock Grid.Column="3"
                                       Text="MHz"
                                       Margin="6,0,0,2"
                                       VerticalAlignment="Center"
                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- SMU 不可用：整页遮罩而非某一行提示；遮罩吃 OverlayScrimBrush，有背景色即参与命中测试 -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding SmuAvailable, Converter={StaticResource InvBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" />

                        <Rectangle Width="2"
                                   Height="15"
                                   RadiusX="1"
                                   RadiusY="1"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"
                                   Margin="0,11,0,0"
                                   Fill="{DynamicResource DangerBrush}" />

                        <Ellipse Width="2.5"
                                 Height="2.5"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"
                                 Margin="0,31,0,0"
                                 Fill="{DynamicResource DangerBrush}" />
                    </Grid>

                    <TextBlock Text="{Binding BlockingTitle, FallbackValue='SMU 接口不可用'}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}" />

                    <TextBlock Text="{Binding BlockingDetail, FallbackValue='请确保已安装 PawnIO 驱动并以管理员权限运行'}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
