<UserControl x:Class="Zentwik.UI.Views.TuningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             xmlns:core="clr-namespace:Zentwik.Core.Services;assembly=Zentwik.Core"
             xmlns:conv="clr-namespace:Zentwik.UI.Converters"
             xmlns:lm="clr-namespace:Zentwik.UI"
             xmlns:views="clr-namespace:Zentwik.UI.Views"
             FontFamily="{DynamicResource AppFontFamily}"
             FontSize="13">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis" />
        <conv:DimOpacityConverter x:Key="DimOpacity" />

        <DataTemplate x:Key="TuningFieldTemplate">
            <Border Style="{StaticResource PanelStyle}" Padding="20,14" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="{Binding Label}"
                               Style="{StaticResource RowTitleStyle}"
                               VerticalAlignment="Center" />

                    <Slider Grid.Row="0" Grid.Column="1"
                            Style="{StaticResource ThinSliderStyle}"
                            VerticalAlignment="Center"
                            Margin="0,0,24,0"
                            Minimum="{Binding Minimum}"
                            Maximum="{Binding Maximum}"
                            TickFrequency="{Binding Step}"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Value, Mode=TwoWay}"
                            IsEnabled="{Binding IsAvailable}"
                            automation:AutomationProperties.Name="{Binding AutomationName}" />

                    <TextBox Grid.Row="0" Grid.Column="2"
                             Style="{StaticResource CoreNumberFieldStyle}"
                             Width="88"
                             FontSize="30"
                             TextAlignment="Right"
                             conv:InputAssist.SelectAllOnFocus="True"
                             automation:AutomationProperties.Name="{Binding AutomationName}"
                             IsReadOnly="{Binding IsUnavailable}"
                             Text="{Binding Text, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Foreground="{DynamicResource TextPrimaryBrush}" />

                    <TextBlock Grid.Row="0" Grid.Column="3"
                               Text="{Binding Unit}"
                               Margin="6,0,0,2"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{Binding Hint}"
                               Style="{StaticResource HintStyle}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="CoreCellTemplate">
            <Border Height="84"
                    Padding="6,8"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ShortName}"
                               HorizontalAlignment="Center"
                               FontFamily="{DynamicResource AppMonoFontFamily}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />

                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Style="{StaticResource SpinArrowButtonStyle}"
                                Width="16"
                                Height="26"
                                Content="−"
                                FontSize="14"
                                Command="{Binding DecrementCommand}"
                                IsEnabled="{Binding IsEditable}"
                                automation:AutomationProperties.Name="{Binding DisplayName, StringFormat=核心 {0} 减一}" />

                        <TextBox Grid.Column="1"
                                 Height="30"
                                 Margin="2,0"
                                 conv:InputAssist.SelectAllOnFocus="True"
                                 automation:AutomationProperties.Name="{Binding DisplayName, StringFormat=核心 {0} 偏移值}"
                                 IsReadOnly="{Binding IsReadOnly}"
                                 Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource CoreNumberFieldStyle}">
                                    <Setter Property="Width" Value="Auto" />
                                    <Setter Property="FontSize" Value="20" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
                                    <Setter Property="TextAlignment" Value="Center" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>

                        <Button Grid.Column="2"
                                Style="{StaticResource SpinArrowButtonStyle}"
                                Width="16"
                                Height="26"
                                Content="+"
                                FontSize="14"
                                Command="{Binding IncrementCommand}"
                                IsEnabled="{Binding IsEditable}"
                                automation:AutomationProperties.Name="{Binding DisplayName, StringFormat=核心 {0} 加一}" />
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource TopBarStyle}"
                Padding="32,0,124,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="调校" Style="{StaticResource PageTitleStyle}" />

                <!-- ProfileBar 会把自身 DataContext 换成 PlanScope，Visibility 不能走默认 DataContext -->
                <views:ProfileBar Kind="{x:Static core:PlanKind.Tuning}" Grid.Column="1"
                                  Margin="16,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding DataContext.IsIntel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource InvBoolToVis}}"
                                  shell:WindowChrome.IsHitTestVisibleInChrome="True" />

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsIntel, Converter={StaticResource InvBoolToVis}}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="回读"
                            Command="{Binding ReadbackCommand}"
                            IsEnabled="{Binding CanOperate}">
                        <TextBlock Text="回读" />
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="取消调校改动"
                            Command="{Binding DiscardCommand}"
                            IsEnabled="{Binding CanOperate}"
                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="取消" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="{Binding Plans.ApplyButtonText}"
                            ToolTip="将当前参数保存到所选方案，并写入硬件"
                            Command="{Binding ApplyCommand}"
                            IsEnabled="{Binding CanSave}">
                        <TextBlock Text="{Binding Plans.ApplyButtonText}" />
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Visibility="{Binding IsIntel, Converter={StaticResource BoolToVis}}"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource ActionButtonStyle}"
                            automation:AutomationProperties.Name="回读"
                            Command="{Binding ReadbackCommand}"
                            IsEnabled="{Binding CanOperate}">
                        <TextBlock Text="回读" />
                    </Button>

                    <Button Style="{StaticResource ActionButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="恢复原始值"
                            ToolTip="写回本次启动时读到的值"
                            Command="{Binding RestoreIntelCommand}"
                            IsEnabled="{Binding CanApplyIntel}">
                        <TextBlock Text="恢复原始值" />
                    </Button>

                    <Button Style="{StaticResource PrimaryButtonStyle}"
                            Margin="8,0,0,0"
                            automation:AutomationProperties.Name="应用到硬件"
                            ToolTip="将当前参数写入处理器"
                            Command="{Binding ApplyIntelCommand}"
                            IsEnabled="{Binding CanApplyIntel}">
                        <TextBlock Text="应用" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <ScrollViewer Style="{StaticResource PageScrollStyle}"
                          Opacity="{Binding SmuAvailable, Converter={StaticResource DimOpacity}}">
                <Grid>
                    <!-- 默认 Stretch + MaxWidth：窄窗收缩不裁切，宽窗到 1320 后与其它页一样居中 -->
                    <StackPanel MaxWidth="{x:Static lm:LayoutMetrics.FormContentWidth}"
                                Margin="32,32,32,32"
                                Visibility="{Binding IsIntel, Converter={StaticResource InvBoolToVis}}">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 电压偏移占左栏，频率上限占右栏 -->
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">

                                <Border Style="{StaticResource SectionHeaderStyle}">
                                    <Grid MinHeight="26">
                                        <TextBlock Text="CURVE OPTIMIZER / 核心电压偏移"
                                                   Style="{StaticResource SectionTitleStyle}" />

                                        <Border x:Name="ScopeSegmentBar"
                                                Style="{StaticResource SegmentGroupStyle}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                automation:AutomationProperties.Name="偏移编辑粒度">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton GroupName="MarginScope"
                                                             Style="{StaticResource SegmentedAccentRadioButtonStyle}"
                                                             Content="全核"
                                                             automation:AutomationProperties.Name="全核统一设置偏移"
                                                             IsChecked="{Binding IsScopeAllCores, Mode=TwoWay}" />
                                                <RadioButton GroupName="MarginScope"
                                                             Style="{StaticResource SegmentedAccentRadioButtonStyle}"
                                                             Content="分 CCD"
                                                             automation:AutomationProperties.Name="按 CCD 设置偏移"
                                                             IsChecked="{Binding IsScopePerCcd, Mode=TwoWay}" />
                                                <RadioButton GroupName="MarginScope"
                                                             Style="{StaticResource SegmentedAccentRadioButtonStyle}"
                                                             Content="分核"
                                                             automation:AutomationProperties.Name="按核心设置偏移"
                                                             IsChecked="{Binding IsScopePerCore, Mode=TwoWay}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- 全核档：一个值作用于全部核心 -->
                                <Border Style="{StaticResource PanelStyle}"
                                        Padding="20,14"
                                        Margin="0,20,0,0"
                                        Visibility="{Binding IsScopeAllCores, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="全部核心"
                                                       Style="{StaticResource RowTitleStyle}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                        Width="20"
                                                        Height="32"
                                                        Margin="0,0,6,0"
                                                        Content="−"
                                                        FontSize="16"
                                                        IsEnabled="{Binding CanOperate}"
                                                        Command="{Binding StepAllCoreCommand}"
                                                        CommandParameter="-"
                                                        automation:AutomationProperties.Name="全部核心偏移减一" />

                                                <TextBox Width="88"
                                                         Style="{StaticResource CoreNumberFieldStyle}"
                                                         FontSize="20"
                                                         FontWeight="SemiBold"
                                                         TextAlignment="Center"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                                         conv:InputAssist.SelectAllOnFocus="True"
                                                         automation:AutomationProperties.Name="全部核心电压偏移"
                                                         Text="{Binding AllCoreText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                                                <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                        Width="20"
                                                        Height="32"
                                                        Margin="6,0,0,0"
                                                        Content="+"
                                                        FontSize="16"
                                                        IsEnabled="{Binding CanOperate}"
                                                        Command="{Binding StepAllCoreCommand}"
                                                        CommandParameter="+"
                                                        automation:AutomationProperties.Name="全部核心偏移加一" />

                                                <TextBlock Text="mV"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource AppMonoFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Slider Style="{StaticResource ThinSliderStyle}"
                                                Margin="0,16,0,0"
                                                Minimum="{Binding CoreMarginMinimum}"
                                                Maximum="{Binding CoreMarginMaximum}"
                                                TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Value="{Binding AllCoreMargin, Mode=TwoWay}"
                                                automation:AutomationProperties.Name="全部核心电压偏移滑块" />

                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="{Binding CoreMarginMinimum}"
                                                       HorizontalAlignment="Left"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding CoreMarginMaximum}"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- 分 CCD 档：每张卡片一个值，作用于该 CCD 的全部核心 -->
                                <ItemsControl ItemsSource="{Binding CoreGroups}"
                                              Margin="0,20,0,-12"
                                              Visibility="{Binding IsScopePerCcd, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12" Padding="20,14">
                                                <StackPanel>
                                                    <Grid>
                                                        <TextBlock Text="{Binding Title}"
                                                                   Style="{StaticResource RowTitleStyle}"
                                                                   HorizontalAlignment="Left"
                                                                   VerticalAlignment="Center" />

                                                        <StackPanel Orientation="Horizontal"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Center">
                                                            <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                                    Width="20"
                                                                    Height="32"
                                                                    Margin="0,0,6,0"
                                                                    Content="−"
                                                                    FontSize="16"
                                                                    IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Command="{Binding DecreaseCommand}"
                                                                    automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 偏移减一}" />

                                                            <TextBox Width="88"
                                                                     Style="{StaticResource CoreNumberFieldStyle}"
                                                                     FontSize="20"
                                                                     FontWeight="SemiBold"
                                                                     TextAlignment="Center"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                     conv:InputAssist.SelectAllOnFocus="True"
                                                                     automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 电压偏移}"
                                                                     Text="{Binding UniformText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />

                                                            <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                                    Width="20"
                                                                    Height="32"
                                                                    Margin="6,0,0,0"
                                                                    Content="+"
                                                                    FontSize="16"
                                                                    IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Command="{Binding IncreaseCommand}"
                                                                    automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 偏移加一}" />

                                                            <TextBlock Text="mV"
                                                                       Margin="8,0,0,0"
                                                                       VerticalAlignment="Center"
                                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <Slider Style="{StaticResource ThinSliderStyle}"
                                                            Margin="0,16,0,0"
                                                            Minimum="{Binding DataContext.CoreMarginMinimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            Maximum="{Binding DataContext.CoreMarginMaximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            TickFrequency="1"
                                                            IsSnapToTickEnabled="True"
                                                            Value="{Binding UniformMargin, Mode=TwoWay}"
                                                            automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 电压偏移滑块}" />

                                                    <Grid Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding DataContext.CoreMarginMinimum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   HorizontalAlignment="Left"
                                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        <TextBlock Text="{Binding DataContext.CoreMarginMaximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                   HorizontalAlignment="Right"
                                                                   FontFamily="{DynamicResource AppMonoFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 分核档：每个 CCD 一张卡片，卡内 4 列 × 2 行 -->
                                <ItemsControl ItemsSource="{Binding CoreGroups}"
                                              Margin="0,20,0,-12"
                                              Visibility="{Binding IsScopePerCore, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource PanelStyle}"
                                                    Margin="0,0,0,12"
                                                    ClipToBounds="True">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource PanelHoverBrush}"
                                                            BorderBrush="{DynamicResource LineBrush}"
                                                            BorderThickness="0,0,0,1"
                                                            Padding="12,6">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Title}"
                                                                       VerticalAlignment="Center"
                                                                       FontSize="12"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                                            <StackPanel Orientation="Horizontal"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Center">
                                                                <Button Style="{StaticResource ActionButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        Content="−"
                                                                        FontSize="13"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Command="{Binding DecreaseCommand}"
                                                                        automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 全部减一}" />
                                                                <Button Style="{StaticResource ActionButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        Margin="4,0,0,0"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Command="{Binding ZeroCommand}"
                                                                        automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 全部归零}">
                                                                    <Ellipse Width="6"
                                                                             Height="6"
                                                                             Stroke="{DynamicResource TextPrimaryBrush}"
                                                                             StrokeThickness="1.2" />
                                                                </Button>
                                                                <Button Style="{StaticResource ActionButtonStyle}"
                                                                        Width="24"
                                                                        Height="24"
                                                                        Padding="0"
                                                                        Margin="4,0,0,0"
                                                                        Content="+"
                                                                        FontSize="13"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        Command="{Binding IncreaseCommand}"
                                                                        automation:AutomationProperties.Name="{Binding Title, StringFormat={}{0} 全部加一}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>

                                                    <ItemsControl ItemsSource="{Binding Items}"
                                                                  ItemTemplate="{StaticResource CoreCellTemplate}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="12,0,0,0">

                                <Border Style="{StaticResource SectionHeaderStyle}">
                                    <!-- 高度随左栏档位控件走，两栏段头才齐平 -->
                                    <Grid MinHeight="{Binding ActualHeight, ElementName=ScopeSegmentBar}">
                                        <TextBlock Text="FMAX TARGET / 最高加速频率"
                                                   Style="{StaticResource SectionTitleStyle}" />
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource PanelStyle}"
                                        Padding="20,14"
                                        Margin="0,20,0,0">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="频率上限"
                                                       Style="{StaticResource RowTitleStyle}"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center" />

                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center">
                                                <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                        Width="20"
                                                        Height="32"
                                                        Margin="0,0,6,0"
                                                        Content="−"
                                                        FontSize="16"
                                                        IsEnabled="{Binding CanOperate}"
                                                        Command="{Binding StepFMaxDownCommand}"
                                                        automation:AutomationProperties.Name="最高加速频率减十" />

                                                <TextBox Width="88"
                                                         Style="{StaticResource CoreNumberFieldStyle}"
                                                         FontSize="20"
                                                         FontWeight="SemiBold"
                                                         TextAlignment="Center"
                                                         conv:InputAssist.SelectAllOnFocus="True"
                                                         automation:AutomationProperties.Name="最高加速频率数值"
                                                         Text="{Binding FMaxText, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}" />

                                                <Button Style="{StaticResource SpinArrowButtonStyle}"
                                                        Width="20"
                                                        Height="32"
                                                        Margin="6,0,0,0"
                                                        Content="+"
                                                        FontSize="16"
                                                        IsEnabled="{Binding CanOperate}"
                                                        Command="{Binding StepFMaxUpCommand}"
                                                        automation:AutomationProperties.Name="最高加速频率加十" />

                                                <TextBlock Text="MHz"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource AppMonoFontFamily}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Grid>

                                        <Slider Style="{StaticResource ThinSliderStyle}"
                                                Margin="0,16,0,0"
                                                Minimum="{Binding FMaxMinimum}"
                                                Maximum="{Binding FMaxMaximum}"
                                                Value="{Binding FMaxMHz, Mode=TwoWay}"
                                                automation:AutomationProperties.Name="最高加速频率" />

                                        <Grid Margin="0,6,0,0">
                                            <TextBlock Text="{Binding FMaxMinimum}"
                                                       HorizontalAlignment="Left"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding FMaxMaximum}"
                                                       HorizontalAlignment="Right"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel MaxWidth="{x:Static lm:LayoutMetrics.FormContentWidth}"
                                Margin="32,32,32,32"
                                Visibility="{Binding IsIntel, Converter={StaticResource BoolToVis}}">

                        <Border Style="{StaticResource SectionHeaderStyle}">
                            <TextBlock Text="VOLTAGE OFFSET / 电压偏移"
                                       Style="{StaticResource SectionTitleStyle}" />
                        </Border>

                        <TextBlock Text="负值为降压，正值为加压"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,14,0,0" />



                        <ItemsControl ItemsSource="{Binding IntelVoltages}"
                                      Margin="0,14,0,0"
                                      ItemTemplate="{StaticResource TuningFieldTemplate}" />

                        <Border Style="{StaticResource SectionHeaderStyle}" Margin="0,14,0,0">
                            <TextBlock Text="TURBO RATIO LIMIT / 睿频上限"
                                       Style="{StaticResource SectionTitleStyle}" />
                        </Border>

                        <TextBlock Text="数值为最大倍频，45 表示 4.5 GHz"
                                   Style="{StaticResource HintStyle}"
                                   Margin="0,14,0,0" />

                        <ItemsControl ItemsSource="{Binding IntelRatios}" Margin="0,14,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}"
                                            CornerRadius="4"
                                            Margin="0,0,12,12"
                                            Padding="8,11">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}"
                                                       HorizontalAlignment="Center"
                                                       FontFamily="{DynamicResource AppMonoFontFamily}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />

                                            <TextBox MinWidth="62"
                                                     HorizontalAlignment="Stretch"
                                                     TextAlignment="Center"
                                                     Margin="0,3,0,0"
                                                     conv:InputAssist.SelectAllOnFocus="True"
                                                     automation:AutomationProperties.Name="{Binding AutomationName}"
                                                     IsReadOnly="{Binding IsUnavailable}"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus, Mode=TwoWay}">
                                                <TextBox.Style>
                                                    <Style TargetType="TextBox" BasedOn="{StaticResource CoreNumberFieldStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBox.Style>
                                            </TextBox>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- 调校通道不可用：整页遮罩而非某一行提示；遮罩吃 OverlayScrimBrush，有背景色即参与命中测试 -->
            <Border Background="{DynamicResource OverlayScrimBrush}"
                    Visibility="{Binding SmuAvailable, Converter={StaticResource InvBoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="48" Height="48" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.5" />

                        <Rectangle Width="2"
                                   Height="15"
                                   RadiusX="1"
                                   RadiusY="1"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Center"
                                   Margin="0,11,0,0"
                                   Fill="{DynamicResource DangerBrush}" />

                        <Ellipse Width="2.5"
                                 Height="2.5"
                                 VerticalAlignment="Top"
                                 HorizontalAlignment="Center"
                                 Margin="0,31,0,0"
                                 Fill="{DynamicResource DangerBrush}" />
                    </Grid>

                    <TextBlock Text="{Binding BlockingTitle, FallbackValue='调校通道不可用'}"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}" />

                    <TextBlock Text="{Binding BlockingDetail, FallbackValue='请确保已安装 PawnIO 驱动并以管理员权限运行'}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
