<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色令牌，取值来自参考稿。与 Tokens.Light 的键集合必须完全一致：主题切换是整份字典按 key 覆盖。强调色不在这，由 AppThemeService 注入 -->

    <!-- 表面 -->
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF09090B" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FF111114" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF111114" />
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#FF18181C" />

    <!-- 线条 -->
    <SolidColorBrush x:Key="LineBrush" Color="#FF27272A" />
    <!-- rgba(255,255,255,0.03)：表格行之间的极细分隔 -->
    <SolidColorBrush x:Key="LineFaintBrush" Color="#08FFFFFF" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="#FF52525B" />
    <!-- rgba(255,255,255,0.05)：单列表单页里行间的虚线分隔 -->
    <SolidColorBrush x:Key="RowDashBrush" Color="#0DFFFFFF" />
    <!-- 同一个值以 Color 形式再存一份：渐变笔刷的 GradientStop 只吃 Color -->
    <Color x:Key="RowDashColor">#0DFFFFFF</Color>

    <!-- 文本 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF71717A" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#FF52525B" />

    <!-- 控件表面 -->
    <SolidColorBrush x:Key="ControlBgBrush" Color="#FF111114" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#FF52525B" />

    <!-- 交互底 -->
    <SolidColorBrush x:Key="ItemHoverBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="ItemSelectedBrush" Color="#14FFFFFF" />

    <!-- 语义色（固定，不随强调色变） -->
    <SolidColorBrush x:Key="AccentSelectionBrush" Color="#4038BDF8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="#1AF87171" />
    <!-- rgba(248,113,113,0.3)：危险区外框 -->
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#4DF87171" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF4ADE80" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="#1AFBBF24" />
    <SolidColorBrush x:Key="WarningBorderBrush" Color="#4DFBBF24" />

    <!-- 日志级别色（取自参考稿的 info / warn / error / debug） -->
    <SolidColorBrush x:Key="LogDebugBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="LogInfoBrush" Color="#FF60A5FA" />
    <SolidColorBrush x:Key="LogWarnBrush" Color="#FFFBBF24" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#FFF87171" />
    <SolidColorBrush x:Key="LogFatalBrush" Color="#FFEF4444" />
    <!-- 警告 / 错误行的正文提亮，与级别列同色系但更浅 -->
    <SolidColorBrush x:Key="LogWarnTextBrush" Color="#FFFDE68A" />
    <SolidColorBrush x:Key="LogErrorTextBrush" Color="#FFFCA5A5" />

    <!-- 浮层遮罩 -->
    <SolidColorBrush x:Key="OverlayScrimBrush" Color="#CC000000" />

    <!-- 悬浮提示（收缩态导航项、图标按钮） -->
    <SolidColorBrush x:Key="ToolTipBgBrush" Color="#FF27272A" />
    <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#FF3F3F46" />

    <!-- 字体 -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="AppMonoFontFamily">Consolas, Cascadia Mono, Courier New, Microsoft YaHei UI</FontFamily>
    <!-- 中文注释行：等宽 ASCII + 无衬线中文，避免落到宋体 -->
    <FontFamily x:Key="AppCommentFontFamily">Consolas, Microsoft YaHei UI, Microsoft YaHei, DengXian</FontFamily>

    <!-- 浮层阴影（只给临时浮层，常驻元素一律不挂 Effect） -->
    <DropShadowEffect x:Key="OverlayShadowEffect"
                      BlurRadius="32" ShadowDepth="8" Direction="270"
                      Color="Black" Opacity="0.7" RenderingBias="Performance" />

</ResourceDictionary>
