<Window x:Class="Zentwik.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:Zentwik.UI.ViewModels"
        xmlns:nav="clr-namespace:Zentwik.UI.Controls"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:views="clr-namespace:Zentwik.UI.Views"
        xmlns:svc="clr-namespace:Zentwik.UI.Services"
        xmlns:lm="clr-namespace:Zentwik.UI"
        Title="Zentwik"
        Width="1240" Height="820"
        MinWidth="{x:Static lm:LayoutMetrics.WindowMinWidth}"
        MinHeight="{x:Static lm:LayoutMetrics.WindowMinHeight}"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        FontFamily="{DynamicResource AppFontFamily}"
        FontSize="13"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <!--
        顶 64px 整条作为系统 caption：拖拽、双击最大化都由 WindowChrome 负责。
        顶栏里的按钮必须标 IsHitTestVisibleInChrome="True"，否则点不到。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid x:Name="BlurTarget" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ==================== 左：可折叠侧栏（72 / 220） ==================== -->
            <Border x:Name="Sidebar"
                    Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="0,0,1,0">
                <Border.Style>
                    <!-- 宽度由 code-behind 做 300ms 过渡，这里只给静止值 -->
                    <Style TargetType="Border">
                        <Setter Property="Width" Value="{x:Static lm:LayoutMetrics.SidebarWidth}" />
                        <Setter Property="ClipToBounds" Value="True" />
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 头部：logo + 字标 + 折叠箭头 -->
                    <Grid Grid.Row="0" Height="{x:Static lm:LayoutMetrics.TopBarHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- 收缩态唯一的展开入口：点 logo -->
                        <Grid x:Name="SidebarHeader"
                              Grid.Column="0"
                              Background="Transparent"
                              Cursor="Hand"
                              shell:WindowChrome.IsHitTestVisibleInChrome="True"
                              MouseLeftButtonUp="OnSidebarHeaderClick"
                              ToolTip="展开侧栏"
                              ToolTipService.IsEnabled="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsCollapsed}">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Width" Value="{x:Static lm:LayoutMetrics.SidebarWidth}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsExpanded}"
                                                     Value="True">
                                            <Setter Property="Width" Value="186" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>

                            <StackPanel x:Name="BrandRow"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsExpanded}"
                                                         Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="Margin" Value="20,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>

                                <!-- 应用图标：几何来自 Themes/BrandLogo.xaml，颜色随强调色重绘 -->
                                <Image x:Name="BrandLogo"
                                       Source="{DynamicResource BrandLogoImage}"
                                       Width="26"
                                       Height="34"
                                       Stretch="Uniform"
                                       VerticalAlignment="Center" />

                                <!-- 字标 + CPU 型号：收缩态整块收起，只留图标 -->
                                <StackPanel x:Name="BrandWordmark"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Width="118"
                                            IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsExpanded}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock FontSize="15"
                                               FontWeight="Bold"
                                               TextOptions.TextFormattingMode="Display">
                                        <Run Text="Zen" Foreground="{DynamicResource TextPrimaryBrush}" /><Run Text="twik" Foreground="{DynamicResource BrandAccentBrush}" />
                                    </TextBlock>

                                    <TextBlock Text="{x:Static svc:CpuInfo.Name}"
                                               Margin="0,4,0,0"
                                               FontFamily="{DynamicResource AppMonoFontFamily}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{x:Static svc:CpuInfo.RawName}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!--
                            折叠箭头：基准朝右（展开侧栏的方向），展开后转 180° 朝左。
                            用户口径：收起用的箭头必须朝左。
                        -->
                        <Button x:Name="SidebarToggle"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="OnSidebarToggleClick"
                                ToolTip="收起侧栏">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SidebarToggleStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsCollapsed}"
                                                     Value="True">
                                            <Setter Property="Opacity" Value="0" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Path Width="18" Height="18" Stretch="Uniform"
                                  Data="M9 6 L15 12 L9 18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <RotateTransform Angle="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsExpanded}"
                                                         Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Button>
                    </Grid>

                    <!-- 导航 -->
                    <StackPanel x:Name="NavHost"
                                Grid.Row="1"
                                Margin="0,16,0,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <RadioButton x:Name="NavTuning" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Tuning"
                                     nav:NavRail.Label="调校" ToolTip="调校" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M3 21 V14 M3 10 V3 M11 21 V12 M11 8 V3 M19 21 V16 M19 12 V3 M1 14 H5 M9 8 H13 M17 16 H21"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavProcess" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Process"
                                     nav:NavRail.Label="调度" ToolTip="调度" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M3 3 H10 V10 H3 Z M14 3 H21 V10 H14 Z M14 14 H21 V21 H14 Z M3 14 H10 V21 H3 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavPower" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Power"
                                     nav:NavRail.Label="电源" ToolTip="电源" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M13 2 L3 14 H12 L11 22 L21 10 H12 L13 2 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavScenarios" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Scenarios"
                                     nav:NavRail.Label="场景" ToolTip="场景" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M6 3 V15 M18 3 A3 3 0 1 0 18 9 A3 3 0 1 0 18 3 M6 15 A3 3 0 1 0 6 21 A3 3 0 1 0 6 15 M18 9 A9 9 0 0 1 9 18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavLogs" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Logs"
                                     nav:NavRail.Label="日志" ToolTip="日志" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M14 2 H6 A2 2 0 0 0 4 4 V20 A2 2 0 0 0 6 22 H18 A2 2 0 0 0 20 20 V8 Z M14 2 V8 H20 M16 13 H8 M16 17 H8"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavMisc" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Misc" IsChecked="True"
                                     nav:NavRail.Label="通用" ToolTip="通用" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M4 6 H20 M4 12 H20 M4 18 H20 M8 4.5 V7.5 M15 10.5 V13.5 M11 16.5 V19.5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavBehavior" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Behavior"
                                     nav:NavRail.Label="行为" ToolTip="行为" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M4 7 H14 A4 4 0 0 0 14 15 H4 M4 7 L7 4 M4 7 L7 10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>

                        <RadioButton x:Name="NavAdvanced" Style="{StaticResource NavRailItemStyle}"
                                     GroupName="Nav" Tag="Advanced"
                                     nav:NavRail.Label="高级" ToolTip="高级" Checked="OnNavChecked">
                            <Path Style="{StaticResource IconGlyphStyle}" Width="20" Height="20"
                                  Data="M12 3 L20 7.5 V16.5 L12 21 L4 16.5 V7.5 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </RadioButton>
                    </StackPanel>

                    <!-- 底部：Worker 连通指示 -->
                    <Border Grid.Row="2"
                            Height="{x:Static lm:LayoutMetrics.TopBarHeight}"
                            Background="Transparent"
                            Cursor="Hand"
                            BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="0,1,0,0"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            MouseLeftButtonUp="OnWorkerStatusClick"
                            automation:AutomationProperties.Name="Worker 连接状态"
                            ToolTip="{Binding Source={x:Static vm:WorkerStatus.Instance}, Path=ToolTipText}">
                        <StackPanel Orientation="Horizontal"
                                    Margin="32,0,0,0"
                                    VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource DangerBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static vm:WorkerStatus.Instance}, Path=IsConnected}"
                                                         Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock Text="{Binding Source={x:Static vm:WorkerStatus.Instance}, Path=StatusText}"
                                       Margin="18,0,12,0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Opacity" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static vm:ShellState.Instance}, Path=IsExpanded}"
                                                         Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ==================== 右：内容 ==================== -->
            <Grid Grid.Column="1">
                <ContentControl x:Name="ContentHost" />
                <views:ToastHost VerticalAlignment="Bottom" Panel.ZIndex="5" />
            </Grid>
        </Grid>

        <!-- 窗口控制：贴顶右角，压在页面顶栏之上 -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,19,6,0"
                    Panel.ZIndex="20"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource WindowButtonStyle}" Click="OnMinimizeClick" ToolTip="最小化">
                <Path Data="M0 5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
            <Button x:Name="MaxButton" Style="{StaticResource WindowButtonStyle}" Click="OnMaximizeClick" ToolTip="最大化">
                <Path x:Name="MaxIcon" Data="M0.5 0.5 H9.5 V9.5 H0.5 Z"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
            <Button Style="{StaticResource WindowCloseButtonStyle}" Click="OnCloseClick" ToolTip="关闭">
                <Path Data="M0.5 0.5 L9.5 9.5 M9.5 0.5 L0.5 9.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.1" Width="10" Height="10" Stretch="Uniform" />
            </Button>
        </StackPanel>

        <views:ConfirmOverlay Panel.ZIndex="110" Margin="0,0,0,-1" />
    </Grid>
</Window>
