<Application x:Class="Zentwik.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework">
    <!-- 资源字典在 AppThemeService 里按索引热切换，不在这里静态合并：令牌(索引0) → 强调色 → 控件样式 -->
    <Application.Resources>
        <ResourceDictionary>

            <!-- 这里的 FocusVisualStyle 覆盖不生效：系统资源不走 Application.Resources。真正生效的是 Controls.xaml 里逐样式显式设置 + FocusVisualKiller 全局兜底 -->

        </ResourceDictionary>
    </Application.Resources>
</Application>
