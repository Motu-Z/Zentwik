<Project Sdk="Microsoft.NET.Sdk">

  <!-- WPF 前端；经命名管道与 Worker 通信，版本号在此唯一定义。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zentwik.UI</RootNamespace>
    <AssemblyName>Zentwik.UI</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>

    <!-- 桌面 UI：工作站 GC + 并发 GC + TieredPGO；不可开 InvariantGlobalization，WPF 依赖真实 culture。 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>

    <Version>2.3.3</Version>
    <FileVersion>2.3.3.0</FileVersion>
    <AssemblyVersion>2.3.3.0</AssemblyVersion>

    <!-- 图标内含 16～256 七档，任意缩放均有原生帧。 -->
    <ApplicationIcon>Assets\Zentwik.ico</ApplicationIcon>

    <!-- 与 Worker 同目录输出，否则开机自启会拉起另一份 UI。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(Configuration)' == 'Release'">D:\Projects\Zentwik-App\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">D:\Projects\Zentwik-App\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core：IPC 契约与序列化，零 WPF 依赖。 -->
    <ProjectReference Include="..\Zentwik.Core\Zentwik.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 源生成 MVVM；AsyncRelayCommand 不并发执行，防止重复下发 SMU 写入。 -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

</Project>
