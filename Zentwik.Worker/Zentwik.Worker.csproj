<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：避免双击弹出控制台窗口。 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- 托盘窗口的 NOTIFYICONDATA 用定长 char 缓冲，LibraryImport 不支持字符串字段按值封送。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- 提权清单：SMU 写入 / 任务计划 / 注册表均需管理员令牌。 -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 与 UI 同目录输出；Debug 落子目录，避免调试构建覆盖安装目录。 -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath Condition="'$(Configuration)' == 'Release'">D:\Projects\Zentwik-App\</OutputPath>
    <OutputPath Condition="'$(Configuration)' != 'Release'">D:\Projects\Zentwik-App\$(Configuration)\</OutputPath>

    <Version>2.6.0-can14</Version>
    <FileVersion>2.4.6.0</FileVersion>
    <AssemblyVersion>2.4.6.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Zentwik.Core\Zentwik.Core.csproj" />
  </ItemGroup>

  <!-- 测试钉住 internal 的 apply-tuning 分派映射，避免复制一份逻辑。 -->
  <ItemGroup>
    <InternalsVisibleTo Include="Zentwik.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
  </ItemGroup>

  <!-- 托盘图标由 UI 侧的 trayicons 诊断开关预渲染；后台服务是 AOT，没有 WPF 渲染路径。 -->
  <ItemGroup>
    <EmbeddedResource Include="Tray\tray-on-dark.bin" LogicalName="Zentwik.Worker.tray-on-dark.bin" />
    <EmbeddedResource Include="Tray\tray-on-light.bin" LogicalName="Zentwik.Worker.tray-on-light.bin" />
  </ItemGroup>

</Project>
