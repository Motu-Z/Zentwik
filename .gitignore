# 编译输出
bin/
obj/
publish/
*.user
*.suo
*.cache

# IDE
.vs/
.vscode/
.idea/

# 内部交接文档，不入库
session_handover.md

# 系统
Thumbs.db
.DS_Store

# 临时发布目录
publish_tmp/
publish_out/

# Python 缓存（xamlcheck.py 运行时生成）
__pycache__/
*.pyc

# AOT 探针的发布产物
build/**/publish/
build/**/bin/
build/**/obj/

# 临时截图与图片（根目录排查截图等误提交；应用资源统一放 Assets/，不受此规则影响）
*.png
*.jpg
*.jpeg
*.bmp
*.gif
!Assets/**
