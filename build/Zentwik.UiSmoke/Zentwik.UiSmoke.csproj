<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI 冒烟探针（不进 Zentwik.slnx）：合并资源字典、new 全部页面、离屏渲染，
    捕捉 XAML 静态检查覆盖不到的 StaticResource 运行期异常。不调 Run()，不碰硬件与提权。
    运行：dotnet run -c Release，产物 out/*.png 与 smoke.log，退出码 0 = 全过。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Zentwik.UiSmoke</RootNamespace>
    <AssemblyName>Zentwik.UiSmoke</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Zentwik.UI\Zentwik.UI.csproj" />
  </ItemGroup>

</Project>
